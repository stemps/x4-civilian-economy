<?xml version="1.0" encoding="utf-8"?>
<cutscene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="cutscenes.xsd">
  <director key="ce_news_raid" comment="Civilian News Network raid broadcast"/>
  <environments>
    <environment_implicit name="scenezone" zone="tzoneCluster_black2_Sector01_Zone_macro"/>
    <object_group name="testgroup"><reference object="playership"/></object_group>
  </environments>
  <presentation>
    <actions>
      <sequence name="Broadcast" start="0">
        <shot name="NewsCard" environment="scenezone" duration="auto">
          <video name="extensions/civilian_economy/videos/ce_news_raid"/>
          <camera_follow reference="playership" orient_to="object" interpolation="smooth"/>
        </shot>
      </sequence>
    </actions>
  </presentation>
</cutscene>
