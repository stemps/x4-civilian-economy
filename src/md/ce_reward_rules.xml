<?xml version="1.0" encoding="utf-8"?>
<mdscript name="CE_RewardRules" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <!-- Pure configuration and projected eligibility. Requires R; never accrues demand. -->
    <library name="Configure"><actions>
      <set_value name="$RewardUnlocks" exact="[2,3,5,7,9]"/>
      <set_value name="$ImmigrationRate" exact="if $R.$Level ge $RewardUnlocks.{1} then 10 * ($R.$Level - 1) else 0"/>
      <set_value name="$PricePoints" exact="if $R.$Level ge $RewardUnlocks.{2} then 2 * ($R.$Level - 2) else 0"/>
      <set_value name="$DiplomacyPoints" exact="if $R.$Level ge $RewardUnlocks.{3} then 2 * ($R.$Level - 4) else 0"/>
      <set_value name="$SensorUnlocked" exact="$R.$Level ge $RewardUnlocks.{4}"/>
      <set_value name="$SurveyUnlocked" exact="$R.$Level ge $RewardUnlocks.{5}"/>
      <set_value name="$SurveyInterval" exact="300.0f"/>
    </actions></library>
    <library name="Evaluate"><actions>
      <include_actions ref="md.CE_RewardRules.Configure"/>
      <set_value name="$RewardNow" exact="player.age / 1s"/>
      <set_value name="$RewardActive" exact="false"/>
      <set_value name="$RewardReason" exact="'hub_unavailable'"/>
      <set_value name="$RewardMissing" exact="[]"/>
      <set_value name="$RewardSupplySeconds" exact="0.0f"/>
      <do_if value="$R.$Hub.exists and not $R.$Hub.iswreck and $R.$Hub.owner == faction.civilian and $R.$Operational and @$R.$Population gt 0">
        <set_value name="$RewardSupplySeconds" exact="86400000.0f"/>
        <set_value name="$RewardRequired" exact="0"/>
        <set_value name="$RewardElapsed" exact="[0.0f,$RewardNow - $R.$Last].max"/>
        <do_for_each name="$RewardWare" in="$R.$Wares.keys.list">
          <set_value name="$RewardW" exact="$R.$Wares.{$RewardWare}"/>
          <do_if value="@$RewardW.$Active and $RewardW.$Rate gt 0">
            <set_value name="$RewardRequired" operation="add"/>
            <set_value name="$RewardRemaining" exact="$RewardW.$Reserve * 3600.0f / $RewardW.$Rate - $RewardElapsed"/>
            <set_value name="$RewardSupplySeconds" exact="[$RewardSupplySeconds,[0.0f,$RewardRemaining].max].min"/>
            <do_if value="$RewardRemaining le 0"><append_to_list name="$RewardMissing" exact="$RewardWare.name"/></do_if>
          </do_if>
        </do_for_each>
        <set_value name="$RewardActive" exact="$RewardRequired gt 0 and $RewardMissing.count == 0"/>
        <set_value name="$RewardReason" exact="if $RewardActive then 'active' else 'shortage'"/>
        <do_if value="$RewardRequired == 0"><set_value name="$RewardReason" exact="'no_demand'"/><set_value name="$RewardSupplySeconds" exact="0.0f"/></do_if>
      </do_if>
    </actions></library>
    <library name="Query" purpose="run_actions">
      <params><param name="Sector"/></params>
      <actions>
        <set_value name="$Result" exact="[false,0,0,0,false,false,'hub_unavailable',[]]"/>
        <do_if value="$Sector and md.CE_CivilianHub.Init.$Registry? and md.CE_CivilianHub.Init.$Registry.{$Sector}?">
          <set_value name="$R" exact="md.CE_CivilianHub.Init.$Registry.{$Sector}"/>
          <include_actions ref="md.CE_RewardRules.Evaluate"/>
          <set_value name="$Result" exact="[$RewardActive,$ImmigrationRate,$PricePoints,$DiplomacyPoints,$SensorUnlocked,$SurveyUnlocked,$RewardReason,$RewardMissing]"/>
        </do_if>
        <return value="$Result"/>
      </actions>
    </library>
  </cues>
</mdscript>
