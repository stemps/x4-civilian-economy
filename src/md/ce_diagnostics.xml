<?xml version="1.0" encoding="utf-8"?>
<mdscript name="CE_Diagnostics" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <cue name="RefreshSelectedHub" instantiate="true" namespace="this">
      <conditions><event_ui_triggered screen="'CEHubStatus'" control="'refresh'"/></conditions>
      <actions>
        <do_if value="not @md.CE_DebugReset.State.$Busy and md.CE_CivilianHub.Init.$Registry?">
          <set_value name="$Registry" exact="md.CE_CivilianHub.Init.$Registry"/>
          <do_for_each name="$Sector" in="$Registry.keys.list">
            <set_value name="$R" exact="$Registry.{$Sector}"/>
            <do_if value="$R.$Hub.exists and not $R.$Hub.iswreck and $R.$Hub.owner == faction.civilian and event.param3 == $R.$Hub">
              <!-- Presentation only: do not accrue simulation time or rewrite offers. -->
              <include_actions ref="PublishDiagnostics"/>
              <include_actions ref="PublishAllDiagnostics"/>
              <raise_lua_event name="'CEHubStatusUpdated'" param="$R.$Hub"/>
              <break/>
            </do_if>
          </do_for_each>
        </do_if>
      </actions>
    </cue>
    <!-- Synchronous libraries in the caller namespace. Controller entry points remain stable. -->
    <library name="PublishDiagnostics">
      <actions>
        <include_actions ref="md.CE_Settings.RequiredGrowth"/>
        <include_actions ref="md.CE_Unrest.Ensure"/>
        <include_actions ref="md.CE_Reserves.SyncAll"/>
        <set_value name="$SnapshotValid" exact="true"/>
        <do_if value="not ($R.$Level? and $R.$Target? and $R.$Operational? and $R.$GrowthSeconds? and $R.$PauseOffers? and $R.$PlotReady? and $R.$TestUpgrade?)">
          <set_value name="$SnapshotValid" exact="false"/>
        </do_if>
        <set_value name="$Rows" exact="[]"/>
        <!-- Presentation reads committed demand records, never rebuilds a profile. -->
        <set_value name="$SnapshotSeen" exact="table[]"/>
        <set_value name="$ActiveCount" exact="0"/>
        <do_for_each name="$Ware" in="$R.$Wares.keys.list">
          <do_if value="@$R.$Wares.{$Ware}.$Active">
            <set_value name="$ActiveCount" operation="add"/>
          </do_if>
        </do_for_each>
        <do_if value="not $R.$Definitions? and $ActiveCount == 0">
          <set_value name="$SnapshotValid" exact="false"/>
        </do_if>
        <do_for_each name="$Ware" in="$R.$DisplayOrder">
          <do_if value="$SnapshotSeen.{$Ware}?">
            <set_value name="$SnapshotValid" exact="false"/>
          </do_if>
          <set_value name="$SnapshotSeen.{$Ware}" exact="true"/>
          <do_if value="$R.$Wares.{$Ware}? and $R.$Wares.{$Ware}.$Active">
            <set_value name="$W" exact="$R.$Wares.{$Ware}"/>
            <do_if value="not ($W.$Reserve? and $W.$Cap? and $W.$Rate? and $W.$Delivered? and $W.$Paid?)">
              <set_value name="$SnapshotValid" exact="false"/>
            </do_if>
            <do_if value="not ($W.$Reserve ge 0 and $W.$Cap ge 0 and $W.$Rate ge 0 and $W.$Delivered ge 0 and $W.$Paid ge 0Cr)">
              <set_value name="$SnapshotValid" exact="false"/>
            </do_if>
            <set_value name="$Available" exact="0"/>
            <set_value name="$Reserved" exact="0"/>
            <do_if value="$W.$Offer.exists">
              <set_value name="$Available" exact="$W.$Offer.amount"/>
              <set_value name="$Reserved" exact="[0,$W.$Offer.offeramount - $Available].max"/>
            </do_if>
            <set_value name="$RemainingSeconds" exact="if $W.$Rate gt 0 then $W.$Reserve * 3600.0f / $W.$Rate else 0.0f"/>
            <append_to_list name="$Rows" exact="[$Ware.name,$W.$Reserve,$W.$Cap,$Available,$Reserved,$W.$Delivered,$W.$Paid / 1Cr,$RemainingSeconds,$W.$Rate,$Ware.id]"/>
          </do_if>
        </do_for_each>
        <do_if value="$Rows.count != $R.$DisplayOrder.count or $Rows.count != $ActiveCount">
          <set_value name="$SnapshotValid" exact="false"/>
        </do_if>
        <do_if value="$SnapshotValid">
          <set_value name="$Unlocks" exact="[]"/>
          <do_if value="$R.$Definitions?">
            <do_for_each name="$NextDefinition" in="$R.$Definitions">
              <do_if value="$NextDefinition.{2} == $R.$Level + 1">
                <append_to_list name="$Unlocks" exact="$NextDefinition.{1}.name"/>
              </do_if>
            </do_for_each>
          </do_if>
          <set_value name="$R.$Snapshot" exact="[$R.$Hub,$R.$Level,$R.$Target,$R.$Operational,$R.$GrowthSeconds,$RequiredGrowthSeconds,$R.$PauseOffers,$R.$PlotReady,$Rows,$R.$TestUpgrade,@$R.$Population,@$R.$PauseReason,3,@$R.$ProfileError,false,$Unlocks,@$R.$PopulationOverride,@$R.$DebugFallback,@$R.$DebugInitialHub != null and $R.$Hub.exists and not $R.$Hub.iswreck and $R.$Hub.owner == faction.civilian and $R.$DebugInitialHub == $R.$Hub and not @$R.$CompletedSequence and $R.$Target == 0]"/>
          <do_if value="@$R.$SnapshotError">
            <debug_text text="'[CE] Details recovered: %s'.[$R.$Hub]"/>
          </do_if>
          <set_value name="$UCriticalRemaining" exact="if $U.$CriticalSince gt 0 then [0.0f,$U.$CriticalSince + 3600 - player.age / 1s].max else -1.0f"/>
          <append_to_list name="$R.$Snapshot" exact="[$U.$Score,$U.$Stage,$U.$Direction,$UCriticalRemaining,$U.$Causes,$U.$Token]"/>
          <include_actions ref="md.CE_DemandEvents.Snapshot"/>
          <append_to_list name="$R.$Snapshot" exact="$DEPayload"/>
          <set_value name="$LayoutPhase" exact="''"/>
          <do_if value="$R.$Hub.exists and not $R.$Hub.iswreck and $R.$Hub.owner == faction.civilian and not @$R.$External and (not @$R.$CompletedSequence or $R.$Target gt 0) and not $R.$Build.exists">
            <set_value name="$LayoutPhase" exact="if @$R.$LayoutPending then 'planning' else if @$R.$ConstructionFailure == 'generation_failed' or @$R.$ConstructionFailure == 'staged_layout_invalid' then 'layout_retry' else if @$R.$ConstructionError then 'build_retry' else 'planning'"/>
          </do_if>
          <append_to_list name="$R.$Snapshot" exact="$LayoutPhase"/>
          <!-- Sector reward payload (CE_Rewards.Snapshot), index 23. -->
          <append_to_list name="$R.$Snapshot" exact="if @$R.$Rewards.$Snapshot then $R.$Rewards.$Snapshot else []"/>
          <!-- Designated (external) hub payload, index 24: [1, maximum level] or empty. -->
          <set_value name="$ExternalPayload" exact="[]"/>
          <do_if value="@$R.$External"><set_value name="$ExternalPayload" exact="[1,$R.$MaxLevel]"/></do_if>
          <append_to_list name="$R.$Snapshot" exact="$ExternalPayload"/>
          <set_value name="$R.$SnapshotError" exact="false"/>
        </do_if>
        <do_else>
          <do_if value="not @$R.$SnapshotError">
            <debug_text text="'[CE] Details refresh failed: hub=%s stage=rows; retaining previous snapshot'.[$R.$Hub]"/>
          </do_if>
          <set_value name="$R.$SnapshotError" exact="true"/>
          <do_if value="$R.$Snapshot?">
            <set_value name="$R.$Snapshot" exact="[$R.$Snapshot.{1},$R.$Snapshot.{2},$R.$Snapshot.{3},$R.$Snapshot.{4},$R.$Snapshot.{5},$R.$Snapshot.{6},$R.$Snapshot.{7},$R.$Snapshot.{8},$R.$Snapshot.{9},$R.$Snapshot.{10},@$R.$Snapshot.{11},@$R.$Snapshot.{12},@$R.$Snapshot.{13},@$R.$ProfileError,true,@$R.$Snapshot.{16},@$R.$PopulationOverride,@$R.$DebugFallback,false,@$R.$Snapshot.{20},@$R.$Snapshot.{21},@$R.$Snapshot.{22},@$R.$Snapshot.{23},@$R.$Snapshot.{24}]"/>
          </do_if>
        </do_else>
      </actions>
    </library>
    <library name="PublishAllDiagnostics">
      <actions>
        <set_value name="$HubList" exact="[]"/>
          <set_value name="$InitialBuildHubs" exact="[]"/>
        <set_value name="$HubSectors" exact="[]"/>
        <set_value name="$BuilderHubs" exact="[]"/>
        <set_value name="$Snapshots" exact="[]"/>
        <do_for_each name="$RegisteredSector" in="$Registry.keys.list">
          <set_value name="$Registered" exact="$Registry.{$RegisteredSector}"/>
          <do_if value="$Registered.$Hub.exists and not $Registered.$Hub.iswreck">
            <append_to_list name="$HubList" exact="$Registered.$Hub"/>
            <do_if value="not @$Registered.$External"><append_to_list name="$BuilderHubs" exact="$Registered.$Hub"/></do_if>
              <do_if value="@$Registered.$InitialHub == $Registered.$Hub and $Registered.$Hub.owner == faction.civilian and $Registered.$Generation == 1 and $Registered.$Level == 1 and $Registered.$Target == 0 and $Registered.$Build.exists and @$Registered.$TargetSequence and (not @md.CE_DebugReset.State.$Busy or @md.CE_DebugReset.State.$Phase == 'initializing')">
                <append_to_list name="$InitialBuildHubs" exact="$Registered.$Hub"/>
              </do_if>
            <append_to_list name="$HubSectors" exact="$RegisteredSector"/>
            <do_if value="$Registered.$Snapshot?">
              <append_to_list name="$Snapshots" exact="$Registered.$Snapshot"/>
            </do_if>
          </do_if>
        </do_for_each>
        <set_value name="player.entity.$ce_initial_build_hubs" exact="$InitialBuildHubs"/>
          <set_value name="player.entity.$ce_hubs" exact="$HubList"/>
        <!-- CE-built hubs only: the builder AI patch leaves designated stations native. -->
        <set_value name="player.entity.$ce_builder_hubs" exact="$BuilderHubs"/>
        <set_value name="player.entity.$ce_hub_sectors" exact="$HubSectors"/>
        <set_value name="player.entity.$ce_hub_statuses" exact="$Snapshots"/>
      </actions>
    </library>
  </cues>
</mdscript>
