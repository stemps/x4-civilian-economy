<?xml version="1.0" encoding="utf-8"?>
<mdscript name="CE_Trade" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <!-- Synchronous libraries in the caller namespace. Controller entry points remain stable. -->
    <library name="RecordDelivery">
      <actions>
        <include_actions ref="md.CE_CivilianHub.AccrueAll"/>
        <set_value name="$Ware" exact="$R.$Transfers.{event.param}"/>
        <set_value name="$W" exact="$R.$Wares.{$Ware}"/>
        <set_value name="$Delivered" exact="event.param.transferredamount"/>
        <!-- Consume guard before any work that can publish or signal. -->
        <remove_value name="$R.$Transfers.{event.param}"/>
        <set_value name="$W.$Reserve" exact="$Delivered" operation="add"/>
        <set_value name="$ReserveState" exact="$W"/>
        <include_actions ref="md.CE_Reserves.SyncWare"/>
        <set_value name="$W.$Delivered" operation="add" exact="$Delivered"/>
        <set_value name="$W.$Paid" operation="add" exact="$Delivered * event.param.unitprice"/>
        <include_actions ref="md.CE_TransactionLog.WatchPayment"/>
        <!-- Sector ownership is evaluated at completion, independently of the seller. -->
        <include_actions ref="md.CE_Settings.Read"/>
        <do_if value="$R.$Hub.sector.isplayerowned and $Delivered gt 0 and event.param.unitprice gt 0Cr and $CETaxPercent gt 0">
          <set_value name="$SalesTax" exact="$Delivered * event.param.unitprice * $CETaxPercent / 100"/>
          <do_if value="$R.$Unrest?">
            <set_value name="$TaxPenalty" exact="if $R.$Unrest.$Stage ge 3 then 75 else if $R.$Unrest.$Stage == 2 then 50 else if $R.$Unrest.$Stage == 1 then 25 else 0"/>
            <set_value name="$SalesTax" exact="$SalesTax * (100 - $TaxPenalty) / 100"/>
          </do_if>
          <!-- Use the native scripted player reward, including its financial history.
               A faction transfer returned a negative result in the water-delivery test.
               Measure the account change; do not infer credited money from that result. -->
          <set_value name="$SalesTaxBalanceBefore" exact="player.money"/>
          <reward_player money="$SalesTax"/>
          <set_value name="$SalesTaxPaid" exact="player.money - $SalesTaxBalanceBefore"/>
          <include_actions ref="md.CE_TransactionLog.LabelTax"/>
          <do_if value="$SalesTaxPaid gt 0Cr and $CETaxNotifications">
            <show_notification text="{974201,127}.[$SalesTaxPaid.formatted.{'%s %Cr'},$R.$Hub.sector.name,$Delivered,$Ware.name]"/>
            <write_to_logbook category="general" title="{974201,126}" text="{974201,127}.[$SalesTaxPaid.formatted.{'%s %Cr'},$R.$Hub.sector.name,$Delivered,$Ware.name]" money="$SalesTaxPaid" object="$R.$Hub" interaction="showonmap"/>
          </do_if>
        </do_if>
        <include_actions ref="md.CE_CivilianHub.UpdateOffers"/>
        <include_actions ref="md.CE_Rewards.Notify"/>
        <include_actions ref="md.CE_CivilianHub.PublishDiagnostics"/>
        <include_actions ref="md.CE_CivilianHub.PublishAllDiagnostics"/>
      </actions>
    </library>
    <!-- Retain saved watcher identities and captured Payment in this namespace. -->
    <cue name="WatchDeliveryPayment" instantiate="true" namespace="this">
      <conditions><event_cue_signalled/></conditions>
      <actions>
        <set_value name="$Payment" exact="event.param"/>
      </actions>
      <cues>
        <cue name="DeliveryAccountPaid">
          <conditions>
            <!-- Both inspected saves clear this ship account at the player receipt
                 timestamp. Ignore partial debits and unrelated account balances. -->
            <event_object_money_updated object="parent.$Payment.$Seller" oldamount="parent.$Payment.$Amount" newamount="0Cr"/>
          </conditions>
          <actions>
            <include_actions ref="md.CE_TransactionLog.PublishPayment"/>
            <cancel_cue cue="parent"/>
          </actions>
        </cue>
        <cue name="DeliveryLabelSellerDestroyed">
          <conditions><event_object_destroyed object="parent.$Payment.$Seller"/></conditions>
          <actions><cancel_cue cue="parent"/></actions>
        </cue>
        <cue name="DeliveryLabelOrderCancelled">
          <conditions><event_object_order_cancelled object="parent.$Payment.$Seller" order="parent.$Payment.$Order" immediate="true"/></conditions>
          <!-- Do not guess the amount/timing of a cancellation refund. -->
          <actions><cancel_cue cue="parent"/></actions>
        </cue>
      </cues>
    </cue>
    <library name="UpdateWarePrice">
      <actions>
        <set_value name="$RawPrice" exact="$Ware.minprice + ($Ware.maxprice - $Ware.minprice) / 10"/>
        <set_value name="$W.$Price" exact="(($RawPrice / 1Cr)i) * 1Cr"/>
        <do_if value="$W.$Price lt $RawPrice">
          <set_value name="$W.$Price" operation="add" exact="1Cr"/>
        </do_if>
      </actions>
    </library>
    <library name="UpdateOffers">
      <actions>
        <include_actions ref="md.CE_Reserves.SyncAll"/>
        <set_value name="$Hub" exact="$R.$Hub"/>
        <!-- Rebuilt for this call only; retain the native deal identities in Transfers. -->
        <set_value name="$UnloadingWares" exact="table[]"/>
        <do_for_each name="$Deal" in="$R.$Transfers.keys.list" reverse="true">
          <do_if value="not $Deal.exists">
            <remove_value name="$R.$Transfers.{$Deal}"/>
          </do_if>
          <do_else>
            <set_value name="$UnloadingWare" exact="$R.$Transfers.{$Deal}"/>
            <set_value name="$UnloadingWares.{$UnloadingWare}" exact="true"/>
          </do_else>
        </do_for_each>
        <do_for_each name="$Ware" in="$R.$Wares.keys.list">
          <set_value name="$W" exact="$R.$Wares.{$Ware}"/>
          <do_if value="not $UnloadingWares.{$Ware}? and $Hub.exists and not $Hub.iswreck">
            <!-- Retired wares keep their last price and accounting record. -->
            <do_if value="$W.$Rate gt 0">
              <include_actions ref="md.CE_CivilianHub.UpdateWarePrice"/>
            </do_if>
            <set_value name="$Desired" exact="if $W.$Rate gt 0 then ($W.$Demand)i else 0"/>
            <do_if value="$W.$Offer.exists">
              <set_value name="$Reserved" exact="[0,$W.$Offer.offeramount - $W.$Offer.amount].max"/>
              <set_value name="$Available" exact="if $R.$Operational and not $R.$PauseOffers then [0,$Desired - $Reserved].max else 0"/>
              <update_trade trade="$W.$Offer" amount="$Available" desiredamount="$Desired" price="$W.$Price"/>
            </do_if>
            <do_elseif value="$Desired gt 0 and $R.$Operational and not $R.$PauseOffers">
              <create_trade_offer name="$W.$Offer" object="$Hub" buyer="$Hub" ware="$Ware" amount="$Desired" desiredamount="$Desired" price="$W.$Price" virtual="true" virtualmoney="false" playeronly="false"/>
            </do_elseif>
          </do_if>
        </do_for_each>
      </actions>
    </library>
  </cues>
</mdscript>
