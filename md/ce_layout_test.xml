<?xml version="1.0" encoding="utf-8"?>
<mdscript name="CE_LayoutTest" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <!-- Saved experimental state only. No command handler or generation remains. -->
    <cue name="State" namespace="this"><conditions><event_cue_signalled/></conditions></cue>
    <cue name="Generate" instantiate="true" namespace="this">
      <conditions><event_cue_signalled/></conditions><actions><cancel_cue cue="this"/></actions>
    </cue>
    <cue name="Reload" instantiate="true">
      <conditions><event_game_loaded/></conditions><actions><include_actions ref="md.CE_LayoutTest.Cleanup"/></actions>
    </cue>
    <cue name="CleanupTick" instantiate="true" checkinterval="1s">
      <conditions><check_value value="@md.CE_LayoutTest.State.$Run != null"/></conditions>
      <actions><include_actions ref="md.CE_LayoutTest.Cleanup"/></actions>
    </cue>
    <library name="Cleanup">
      <actions>
        <do_if value="player.entity.$ce_layout_test?"><remove_value name="player.entity.$ce_layout_test"/></do_if>
        <do_if value="@md.CE_LayoutTest.State.$Run">
          <set_value name="$Run" exact="md.CE_LayoutTest.State.$Run"/>
          <set_value name="$Run.$Active" exact="false"/>
          <set_value name="$Run.$Waiting" exact="false"/>
          <do_if value="@$Run.$Worker.exists"><cancel_cue cue="$Run.$Worker"/></do_if>
          <set_value name="$Run.$Worker" exact="null"/>
          <do_if value="$Run.$Probe.exists and $Run.$Probe.owner == faction.civilian">
            <do_if value="not @$Run.$CleanupSent and not player.entity.hascontext.{$Run.$Probe}">
              <set_value name="$ResetObject" exact="$Run.$Probe"/>
              <include_actions ref="md.CE_DebugReset.CheckVisitors"/>
              <do_if value="not $ResetOccupied">
                <destroy_object object="$Run.$Probe" explosion="false"/>
                <set_value name="$Run.$CleanupSent" exact="true"/>
              </do_if>
            </do_if>
          </do_if>
          <do_else><set_value name="md.CE_LayoutTest.State.$Run" exact="null"/></do_else>
        </do_if>
      </actions>
    </library>
  </cues>
</mdscript>
