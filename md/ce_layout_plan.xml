<?xml version="1.0" encoding="utf-8"?>
<mdscript name="CE_LayoutPlan" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <!-- Caller owns the station, callback listener and cancellation. These libraries
         run in that caller's namespace and never apply a sequence to the station. -->
    <library name="Begin">
      <actions>
        <set_value name="$CandidatePlans" exact="[]"/>
        <set_value name="$PlansRejected" exact="false"/>
        <set_value name="$PlanningFinished" exact="false"/>
        <set_value name="$PlanFailureKind" exact="null"/>
        <set_value name="$PlanBiasIndex" exact="[1.0f,0.5f,2.0f].indexof.{$LayoutBias}"/>
        <do_if value="$PlanBiasIndex == 0"><set_value name="$PlanBiasIndex" exact="1"/></do_if>
        <set_value name="$BuildLevel" exact="1"/>
        <set_value name="$StageAttempt" exact="1"/>
        <set_value name="$Base" exact="null"/>
        <include_actions ref="md.CE_LayoutPlan.Request"/>
      </actions>
    </library>
    <library name="Request">
      <actions>
        <include_actions ref="md.CE_Construction.Requirements"/>
        <set_value name="$NewMacros" exact="$RequiredMacros.clone"/>
        <do_if value="$Base">
          <do_all exact="$Base.count" counter="$PlanIndex">
            <set_value name="$MacroIndex" exact="$NewMacros.indexof.{$Base.{$PlanIndex}.macro}"/>
            <do_if value="$MacroIndex gt 0"><remove_value name="$NewMacros.{$MacroIndex}"/></do_if>
          </do_all>
        </do_if>
        <set_value name="$BiasIndex" exact="(($PlanBiasIndex + $StageAttempt - 2) % 3) + 1"/>
        <set_value name="$LayoutBias" exact="[1.0f,0.5f,2.0f].{$BiasIndex}"/>
        <include_actions ref="md.CE_Construction.GenerateNative"/>
      </actions>
    </library>
    <library name="Receive">
      <actions>
        <do_if value="not $PlanningFinished">
          <include_actions ref="md.CE_Construction.ValidateSequence"/>
          <do_if value="$ValidSequence">
            <append_to_list name="$CandidatePlans" exact="$Sequence"/>
            <do_if value="$BuildLevel == 10"><include_actions ref="md.CE_LayoutPlan.Finish"/></do_if>
            <do_else>
              <set_value name="$Base" exact="$Sequence"/>
              <set_value name="$BuildLevel" operation="add"/>
              <set_value name="$StageAttempt" exact="1"/>
              <include_actions ref="md.CE_LayoutPlan.Request"/>
            </do_else>
          </do_if>
          <do_else>
            <set_value name="$PlanFailureKind" exact="if $Sequence then 'staged_layout_invalid' else 'generation_failed'"/>
            <debug_text text="'[CE] Forward layout rejected: hub=%s level=%s attempt=%s reason=%s missing=%s unexpected=%s changed_ids=%s'.[$Station,$BuildLevel,$StageAttempt,$ConstructionFailure,$Remaining,$UnexpectedMacros,$ChangedBaseIDs]"/>
            <do_if value="$StageAttempt lt 3">
              <set_value name="$StageAttempt" operation="add"/>
              <include_actions ref="md.CE_LayoutPlan.Request"/>
            </do_if>
            <do_else>
              <set_value name="$PlansRejected" exact="true"/>
              <include_actions ref="md.CE_LayoutPlan.Finish"/>
            </do_else>
          </do_else>
        </do_if>
      </actions>
    </library>
    <library name="Finish">
      <actions>
        <set_value name="$PlanningFinished" exact="true"/>
        <debug_text text="'[CE] Forward planning finished: hub=%s success=%s stages=%s'.[$Station,not $PlansRejected,$CandidatePlans.count]"/>
        <set_value name="$BuildLevel" exact="$RequestedLevel"/>
        <set_value name="$Base" exact="null"/>
        <include_actions ref="md.CE_Construction.Requirements"/>
        <set_value name="$Sequence" exact="null"/>
        <do_if value="not $PlansRejected and $CandidatePlans.count == 10">
          <set_value name="$R.$LayoutPlans" exact="$CandidatePlans"/>
          <set_value name="$R.$LayoutPlanHub" exact="$Station"/>
          <set_value name="$Sequence" exact="$CandidatePlans.{$BuildLevel}"/>
        </do_if>
        <do_else><set_value name="$CandidatePlans" exact="[]"/></do_else>
      </actions>
    </library>
  </cues>
</mdscript>
