<?xml version="1.0" encoding="utf-8"?>
<mdscript name="CE_DebugEvents" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <cue name="Request" instantiate="true" namespace="this">
      <conditions><event_ui_triggered screen="'CEEventTesting'"/></conditions>
      <actions>
        <include_actions ref="md.CE_Settings.Ensure"/>
        <do_if value="not @md.CE_DebugReset.State.$Busy and md.CE_Settings.State.$Debug and md.CE_OwnerlessHub.Init.$Registry?">
          <set_value name="$Registry" exact="md.CE_OwnerlessHub.Init.$Registry"/>
          <do_for_each name="$Sector" in="$Registry.keys.list">
            <set_value name="$R" exact="$Registry.{$Sector}"/>
            <do_if value="$R.$Hub.exists and not $R.$Hub.iswreck and $R.$Hub.owner == faction.civilian and event.param3 == $R.$Hub and $R.$DemandEvents? and not @$R.$SnapshotError">
              <do_all exact="12" counter="$DECommandIndex">
                <set_value name="$DERequestID" exact="$DECommandIndex - 1"/>
                <do_for_each name="$DERequestMode" in="['start','end']">
                  <set_value name="$DEExpected" exact="'%1:%2:%3'.[$DERequestMode,$DERequestID,$R.$DemandEvents.$Token]"/>
                  <do_if value="event.param2 == $DEExpected">
                    <set_value name="$R.$DemandEvents.$Token" operation="add"/>
                    <include_actions ref="md.CE_Reserves.Accrue"/>
                    <do_if value="$DERequestMode == 'end'">
                      <set_value name="$DEEndID" exact="$DERequestID"/>
                      <include_actions ref="md.CE_DemandEvents.End"/>
                    </do_if>
                    <do_elseif value="$DERequestID gt 0 and $R.$Operational and not @$R.$ProfileError">
                      <set_value name="$DEChosen" exact="$DERequestID"/>
                      <include_actions ref="md.CE_DemandEvents.Start"/>
                    </do_elseif>
                    <include_actions ref="md.CE_Reserves.Qualify"/>
                    <include_actions ref="md.CE_OwnerlessHub.UpdateOffers"/>
                    <include_actions ref="md.CE_Diagnostics.PublishDiagnostics"/>
                    <include_actions ref="md.CE_Diagnostics.PublishAllDiagnostics"/>
                    <break/>
                  </do_if>
                </do_for_each>
              </do_all>
            </do_if>
          </do_for_each>
        </do_if>
      </actions>
    </cue>
  </cues>
</mdscript>
