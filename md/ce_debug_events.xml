<?xml version="1.0" encoding="utf-8"?>
<mdscript name="CE_DebugEvents" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <cue name="Request" instantiate="true" namespace="this">
      <conditions><event_ui_triggered screen="'CEEventTesting'"/></conditions>
      <actions>
        <include_actions ref="md.CE_Settings.Ensure"/>
        <do_if value="md.CE_Settings.State.$Debug and md.CE_OwnerlessHub.Init.$Registry?">
          <set_value name="$Registry" exact="md.CE_OwnerlessHub.Init.$Registry"/>
          <do_for_each name="$Sector" in="$Registry.keys.list">
            <set_value name="$R" exact="$Registry.{$Sector}"/>
            <do_if value="$R.$Hub.exists and not $R.$Hub.iswreck and $R.$Hub.owner == faction.ownerless and event.param3 == $R.$Hub and $R.$DemandEvent? and not @$R.$SnapshotError">
              <do_all exact="12" counter="$DECommandIndex">
                <set_value name="$DEChosen" exact="$DECommandIndex - 1"/>
                <set_value name="$DEExpected" exact="'%1:%2'.[$DEChosen,$R.$DemandEvent.$Token]"/>
                <do_if value="event.param2 == $DEExpected">
                  <!-- Consume before accruing: expiry may itself invalidate this token. -->
                  <set_value name="$R.$DemandEvent.$Token" operation="add"/>
                  <include_actions ref="md.CE_Reserves.Accrue"/>
                  <include_actions ref="md.CE_DemandEvents.Candidates"/>
                  <do_if value="$DEChosen == 0"><include_actions ref="md.CE_DemandEvents.End"/></do_if>
                  <do_elseif value="$R.$Operational and not @$R.$ProfileError and $DECandidates.indexof.{$DEChosen}"><include_actions ref="md.CE_DemandEvents.Start"/></do_elseif>
                  <include_actions ref="md.CE_Reserves.Qualify"/>
                  <include_actions ref="md.CE_OwnerlessHub.UpdateOffers"/>
                  <include_actions ref="md.CE_Diagnostics.PublishDiagnostics"/>
                  <include_actions ref="md.CE_Diagnostics.PublishAllDiagnostics"/>
                  <break/>
                </do_if>
              </do_all>
            </do_if>
          </do_for_each>
        </do_if>
      </actions>
    </cue>
  </cues>
</mdscript>
