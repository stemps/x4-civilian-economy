<?xml version='1.0' encoding='utf-8'?>
<mdscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="CE_Construction" xsi:noNamespaceSchemaLocation="md.xsd">
<cues>
<cue name="InitialBuilds" instantiate="true" checkinterval="1s" namespace="this">
  <conditions><check_value value="@player.entity.$ce_initial_build_hubs.count gt 0"/></conditions>
  <actions>
    <set_value name="$Registry" exact="md.CE_CivilianHub.Init.$Registry"/>
    <do_if value="not @md.CE_DebugReset.State.$Busy or @md.CE_DebugReset.State.$Phase == 'initializing'">
      <do_for_each name="$Sector" in="$Registry.keys.list">
        <set_value name="$R" exact="$Registry.{$Sector}"/>
        <do_if value="@$R.$InitialHub != null and $R.$InitialHub == $R.$Hub and $R.$Hub.exists and not $R.$Hub.iswreck and $R.$Hub.owner == faction.civilian">
          <include_actions ref="md.CE_Construction.InitialTick"/>
          <include_actions ref="md.CE_CivilianHub.UpdateHub"/>
        </do_if>
      </do_for_each>
    </do_if>
    <include_actions ref="md.CE_Diagnostics.PublishAllDiagnostics"/>
  </actions>
</cue>
<library name="Resolve"><actions>
  <set_value name="$LayoutRace" exact="if $ProfileRace then $ProfileRace.id else ''"/>
  <include_actions ref="md.CE_ConstructionData.Load"/>
  <!-- Fingerprint records which generated layout data this snapshot expects. -->
  <set_value name="$Construction" exact="table[$Plan='ce_hub_%1'.[$LayoutRace],$Levels=$LayoutMacros,$Valid=false,$Fingerprint=$LayoutFingerprint]"/>
  <do_if value="$LayoutMacros.count == 10">
    <set_value name="$Available" exact="[]"/>
    <get_module_definition race="$ProfileRace" tags="tag.module" multiple="true" macro="$Choices"/>
    <do_for_each name="$Choice" in="$Choices"><append_to_list name="$Available" exact="$Choice.id"/></do_for_each>
    <set_value name="$Construction.$Valid" exact="true"/>
    <do_for_each name="$Name" in="$LayoutMacros.{10}">
      <do_if value="not $Available.indexof.{$Name}"><set_value name="$Construction.$Valid" exact="false"/></do_if>
    </do_for_each>
  </do_if>
</actions></library>
<library name="Queue"><actions>
  <set_value name="$Hub" exact="$R.$Hub"/>
  <do_if value="$Hub.exists and not $Hub.iswreck and $Hub.owner == faction.civilian and not @$R.$LayoutPending and not $R.$Build.exists">
    <set_value name="$BuildLevel" exact="if $R.$Target gt 0 then $R.$Target else $R.$Level"/>
    <set_value name="$CheckSequence" exact="@$R.$TargetSequence"/>
    <set_value name="$CheckLevel" exact="$BuildLevel"/>
    <include_actions ref="md.CE_Construction.CheckReady"/>
    <do_if value="not $SequenceReady and (not @$R.$CompletedSequence or $R.$Target gt 0) and (not $Hub.buildstorage.exists or $Hub.buildstorage.builds.queued.count + $Hub.buildstorage.builds.inprogress.count == 0)">
      <do_if value="$R.$Construction.$Valid and @$R.$Construction.$Levels.count == 10">
        <include_actions ref="md.CE_Placement.Prepare"/>
        <do_if value="$PlacementReady">
          <set_value name="$R.$LayoutToken" exact="if $R.$LayoutToken? then $R.$LayoutToken + 1 else 1"/>
          <set_value name="$R.$LayoutPending" exact="true"/>
          <set_value name="$R.$LayoutLevel" exact="$BuildLevel"/>
          <include_actions ref="md.CE_Placement.Requested"/>
          <signal_cue_instantly cue="md.CE_Construction.Generate" param="[$R,$Hub,$R.$LayoutToken,$BuildLevel]"/>
        </do_if>
      </do_if>
      <do_else><set_value name="$ConstructionFailure" exact="'invalid_components'"/><include_actions ref="md.CE_Construction.ReportFailure"/></do_else>
    </do_if>
  </do_if>
  <include_actions ref="md.CE_Construction.InitialTick"/>
</actions></library>
<cue name="Generate" instantiate="true" namespace="this">
<conditions><event_cue_signalled/></conditions><actions>
  <set_value name="$R" exact="event.param.{1}"/>
  <set_value name="$Hub" exact="event.param.{2}"/>
  <set_value name="$Token" exact="event.param.{3}"/>
  <set_value name="$BuildLevel" exact="event.param.{4}"/>
  <do_if value="(not @md.CE_DebugReset.State.$Busy or @md.CE_DebugReset.State.$Phase == 'initializing') and $R.$Hub == $Hub and $Hub.exists and not $Hub.iswreck and $Hub.owner == faction.civilian and $R.$LayoutToken == $Token and $R.$LayoutPending">
    <set_value name="$R.$LayoutPending" exact="false"/>
    <do_if value="not $Hub.buildstorage.exists"><create_build_storage station="$Hub"/></do_if>
    <set_value name="$Valid" exact="false"/>
    <set_value name="$ConstructionFailure" exact="'build_storage_unavailable_or_busy'"/>
    <do_if value="$Hub.buildstorage.exists and $Hub.buildstorage.builds.queued.count + $Hub.buildstorage.builds.inprogress.count == 0 and not $R.$Build.exists">
      <include_actions ref="md.CE_ConstructionStages.Queue"/>
    </do_if>
    <do_if value="$Valid">
      <set_value name="$R.$TargetSequence" exact="$Sequence"/>
      <include_actions ref="md.CE_Construction.StartBuild"/>
      <include_actions ref="md.CE_Construction.InitialTick"/>
    </do_if>
    <do_else>
      <do_if value="$R.$Build.exists"><remove_build object="$Hub.buildstorage" build="$R.$Build"/></do_if>
      <set_value name="$R.$Build" exact="null"/>
      <!-- A master that never passed validation is not retained: the retry reloads the plan. -->
      <do_if value="not @$R.$PlanIDs.count"><set_value name="$R.$FullSequence" exact="null"/></do_if>
      <include_actions ref="md.CE_Construction.ReportFailure"/>
      <include_actions ref="md.CE_Placement.Failed"/>
    </do_else>
  </do_if>
</actions></cue>
<library name="ReportFailure"><actions>
  <do_if value="not @$R.$ConstructionError">
    <write_to_logbook category="general" title="{974201,1}" text="{974201,123}.[$R.$ProfileRace]"/>
    <debug_text text="'[CE] Construction blocked: hub=%s stage=%s race=%s plan=%s'.[$R.$Hub,$ConstructionFailure,$R.$ProfileRace,@$R.$Construction.$Plan]"/>
  </do_if>
  <set_value name="$R.$ConstructionError" exact="true"/>
  <set_value name="$R.$ConstructionFailure" exact="$ConstructionFailure"/>
</actions></library>
<library name="InitialTick"><actions>
  <!-- Only first-generation level-1 seeds/reset hubs may bypass resource delivery. -->
  <do_if value="@$R.$InitialHub == $R.$Hub and $R.$Hub.exists and $R.$Hub.owner == faction.civilian and $R.$Generation == 1 and $R.$Level == 1 and $R.$Target == 0 and $R.$Build.exists and @$R.$TargetSequence and (not @md.CE_DebugReset.State.$Busy or @md.CE_DebugReset.State.$Phase == 'initializing')">
    <do_if value="not @$R.$InitialForceAt or player.age ge $R.$InitialForceAt">
      <set_value name="$Registry" exact="md.CE_CivilianHub.Init.$Registry"/>
      <include_actions ref="md.CE_Diagnostics.PublishAllDiagnostics"/>
      <raise_lua_event name="'CEInitialHubBuildReady'" param="$R.$Hub"/>
      <set_value name="$R.$InitialForceAt" exact="player.age + 2s"/>
    </do_if>
  </do_if>
</actions></library>
<library name="StartBuild">
      <actions>
        <!-- Both asynchronous acceptance and task recovery use the captured record. -->
        <set_value name="$Hub" exact="$R.$Hub"/>
        <set_value name="$Sector" exact="$Hub.sector"/>
        <do_if value="$R.$Build.exists">
          <set_value name="$R.$ConstructionError" exact="false"/>
          <set_value name="$R.$ConstructionFailure" exact="null"/>
          <include_actions ref="md.CE_Placement.Succeeded"/>
          <process_build build="$R.$Build" object="$Hub.buildstorage" buildmodule="$Hub.buildstorage.buildmodule"/>
          <include_actions ref="md.CE_Notifications.UpgradeStarted"/>
          <debug_text text="'[CE] Build started: hub=%s build=%s'.[$Hub,$R.$Build]"/>
          <include_actions ref="md.CE_CivilianHub.FundAccounts"/>
          <debug_text text="'[CE] Build funding checked: hub=%s balance=%s wanted=%s'.[$Hub,$Hub.buildstorage.money,$Hub.buildstorage.wantedmoney]"/>
          <include_actions ref="md.CE_CivilianHub.AssignBuilder"/>
          <include_actions ref="md.CE_DebugAdvance.Tick"/>
          <include_actions ref="md.CE_DebugCreate.Tick"/>
        </do_if>
        <do_else>
          <set_value name="$ConstructionFailure" exact="'build_task_creation_failed'"/>
          <include_actions ref="md.CE_Construction.ReportFailure"/>
          <include_actions ref="md.CE_Placement.Failed"/>
        </do_else>
      </actions>
    </library>
    <library name="Readiness">
      <actions>
        <set_value name="$Ready" exact="false"/>
        <set_value name="$TargetReady" exact="false"/>
        <set_value name="$R.$PauseReason" exact="'hub_unavailable'"/>
        <do_if value="$Hub.exists and not $Hub.iswreck and $Hub.owner != faction.civilian"><set_value name="$R.$PauseReason" exact="'owner_changed'"/></do_if>
        <do_if value="$Hub.exists and not $Hub.iswreck and $Hub.owner == faction.civilian">
          <set_value name="$CheckSequence" exact="@$R.$CompletedSequence"/>
          <set_value name="$CheckLevel" exact="$R.$Level"/><include_actions ref="md.CE_Construction.CheckReady"/>
          <set_value name="$Ready" exact="$SequenceReady and (not $R.$Population? or $R.$Population gt 0)"/>
          <set_value name="$R.$PauseReason" exact="if $Ready then 'active' else if $Damaged then 'damaged_modules' else if $Constructing then 'constructing' else if $R.$Population? and $R.$Population == 0 then 'no_population' else 'modules_unavailable'"/>
          <set_value name="$CheckSequence" exact="@$R.$TargetSequence"/>
          <set_value name="$CheckLevel" exact="if $R.$Target gt 0 then $R.$Target else $R.$Level"/><include_actions ref="md.CE_Construction.CheckReady"/>
          <do_if value="$SequenceReady">
            <!-- Initial/replacement build restores the earned level without an upgrade. -->
            <do_if value="not @$R.$CompletedSequence and $R.$Target == 0">
              <do_if value="@$R.$InitialHub == $Hub">
                <set_value name="$R.$InitialHub" exact="null"/>
                <set_value name="$Registry" exact="md.CE_CivilianHub.Init.$Registry"/>
                <include_actions ref="md.CE_Diagnostics.PublishAllDiagnostics"/>
              </do_if><set_value name="$R.$CompletedSequence" exact="$R.$TargetSequence"/>
              <set_value name="$R.$TargetSequence" exact="null"/>
              <set_value name="$R.$Build" exact="null"/>
              <set_value name="$Ready" exact="not $R.$Population? or $R.$Population gt 0"/>
              <set_value name="$R.$PauseReason" exact="if $Ready then 'active' else 'no_population'"/>
            </do_if>
            <do_elseif value="$Ready and $R.$Target gt 0"><set_value name="$TargetReady" exact="true"/></do_elseif>
          </do_if>
        </do_if>
      </actions>
    </library>
    <library name="CheckReady">
      <actions>
        <set_value name="$ExpectedCount" exact="if $CheckSequence then @$R.$Construction.$Levels.{$CheckLevel}.count else 0"/><set_value name="$SequenceReady" exact="$CheckSequence != null and $ExpectedCount gt 0 and $Hub.constructionsequence.count ge $ExpectedCount"/>
        <set_value name="$Constructing" exact="not $SequenceReady"/>
        <set_value name="$Damaged" exact="false"/>
        <do_if value="$CheckSequence">
          <do_all exact="$ExpectedCount" counter="$i">
            <set_value name="$EntryID" exact="$CheckSequence.{$i}.id"/>
            <do_if value="not @$Hub.planmodule.{$EntryID}.isoperational">
              <set_value name="$SequenceReady" exact="false"/>
              <do_if value="@$Hub.planmodule.{$EntryID}.iswreck"><set_value name="$Damaged" exact="true"/></do_if>
              <do_elseif value="not @$Hub.planmodule.{$EntryID}.exists or @$Hub.planmodule.{$EntryID}.isconstruction"><set_value name="$Constructing" exact="true"/></do_elseif>
            </do_if>
          </do_all>
        </do_if>
      </actions>
    </library>
    <!-- Saved construction snapshots outlive the generated layout data they were
         resolved from, while plan IDs stay stable across mod versions. Called on
         save load in the controller namespace ($Registry, $RaceProfiles,
         $SectorProfiles). Stale or unresolved snapshots are re-resolved once per
         race. Records with an accepted stage keep their snapshot: it matches their
         saved native master sequence, which later stages continue from. -->
    <library name="RefreshSnapshots">
      <actions>
        <set_value name="$LayoutRace" exact="''"/>
        <include_actions ref="md.CE_ConstructionData.Load"/>
        <set_value name="$CurrentLayout" exact="$LayoutFingerprint"/>
        <set_value name="$RefreshedRaces" exact="table[]"/>
        <do_for_each name="$RefreshProfileKey" in="$RaceProfiles.keys.list">
          <set_value name="$RefreshProfile" exact="$RaceProfiles.{$RefreshProfileKey}"/>
          <include_actions ref="md.CE_Construction.RefreshProfileSnapshot"/>
        </do_for_each>
        <do_for_each name="$Sector" in="$Registry.keys.list">
          <set_value name="$R" exact="$Registry.{$Sector}"/>
          <do_if value="@$R.$DebugProfile">
            <set_value name="$RefreshProfile" exact="$R.$DebugProfile"/>
            <include_actions ref="md.CE_Construction.RefreshProfileSnapshot"/>
          </do_if>
          <do_if value="@$R.$PlanIDs.count or @$R.$Build.exists">
            <do_if value="@$R.$Construction.$Fingerprint != $CurrentLayout">
              <include_actions ref="md.CE_Construction.MatchSnapshot"/>
              <do_if value="$SnapshotMatches">
                <!-- Identical plan and macro lists: re-stamp without touching the master. -->
                <set_value name="$R.$Construction" exact="$MatchSource.$Construction"/>
              </do_if>
              <do_else>
                <debug_text text="'[CE] Hub keeps its saved construction layout: hub=%s level=%s'.[$R.$Hub,$R.$Level]"/>
              </do_else>
            </do_if>
          </do_if>
          <do_else><include_actions ref="md.CE_Construction.AdoptSnapshot"/></do_else>
        </do_for_each>
      </actions>
    </library>
    <library name="RefreshProfileSnapshot">
      <actions>
        <!-- Input RefreshProfile (a race or debug profile table), CurrentLayout and
             RefreshedRaces. Replaces only the profile's construction snapshot. -->
        <do_if value="not @$RefreshProfile.$Construction.$Valid or @$RefreshProfile.$Construction.$Fingerprint != $CurrentLayout">
          <set_value name="$RefreshRaceKey" exact="if @$RefreshProfile.$Race then '$' + $RefreshProfile.$Race else '$unknown'"/>
          <do_if value="not $RefreshedRaces.{$RefreshRaceKey}?">
            <set_value name="$ProfileRace" exact="null"/>
            <do_for_each name="$RefreshRace" in="lookup.race.list">
              <do_if value="$RefreshRace.id == @$RefreshProfile.$Race"><set_value name="$ProfileRace" exact="$RefreshRace"/></do_if>
            </do_for_each>
            <include_actions ref="md.CE_Construction.Resolve"/>
            <set_value name="$RefreshedRaces.{$RefreshRaceKey}" exact="$Construction"/>
            <debug_text text="'[CE] Construction snapshot refreshed: race=%s valid=%s previous_layout=%s'.[@$RefreshProfile.$Race,$Construction.$Valid,@$RefreshProfile.$Construction.$Fingerprint]"/>
          </do_if>
          <set_value name="$RefreshProfile.$Construction" exact="$RefreshedRaces.{$RefreshRaceKey}"/>
        </do_if>
      </actions>
    </library>
    <library name="MatchSnapshot">
      <actions>
        <!-- Input R and Sector. True when the record's snapshot expects exactly the
             plan and per-level macros of its current valid profile snapshot. -->
        <set_value name="$MatchSource" exact="if @$R.$DebugProfile then $R.$DebugProfile else if $Sector then @$SectorProfiles.{$Sector} else null"/>
        <set_value name="$MatchCurrent" exact="@$MatchSource.$Construction"/>
        <set_value name="$MatchSaved" exact="$R.$Construction"/>
        <set_value name="$SnapshotMatches" exact="@$MatchCurrent.$Valid and @$MatchSaved.$Valid and $MatchCurrent.$Plan == $MatchSaved.$Plan and @$MatchCurrent.$Levels.count == 10 and @$MatchSaved.$Levels.count == 10"/>
        <do_if value="$SnapshotMatches">
          <do_all exact="10" counter="$MatchLevel">
            <do_if value="$MatchCurrent.$Levels.{$MatchLevel}.count != $MatchSaved.$Levels.{$MatchLevel}.count">
              <set_value name="$SnapshotMatches" exact="false"/>
            </do_if>
            <do_elseif value="$SnapshotMatches">
              <do_all exact="$MatchCurrent.$Levels.{$MatchLevel}.count" counter="$MatchIndex">
                <do_if value="$MatchCurrent.$Levels.{$MatchLevel}.{$MatchIndex} != $MatchSaved.$Levels.{$MatchLevel}.{$MatchIndex}">
                  <set_value name="$SnapshotMatches" exact="false"/>
                </do_if>
              </do_all>
            </do_elseif>
          </do_all>
        </do_if>
      </actions>
    </library>
    <library name="AdoptSnapshot">
      <actions>
        <!-- Input R and Sector. A record without an accepted stage has no native
             master to stay consistent with, so it follows its current profile. -->
        <set_value name="$AdoptSource" exact="if @$R.$DebugProfile then $R.$DebugProfile else if $Sector then @$SectorProfiles.{$Sector} else null"/>
        <do_if value="@$AdoptSource.$Construction and not @$R.$PlanIDs.count and not @$R.$Build.exists">
          <set_value name="$R.$FullSequence" exact="null"/>
          <set_value name="$R.$PlanIDs" exact="[]"/>
          <do_if value="@$R.$Construction.$Fingerprint != $AdoptSource.$Construction.$Fingerprint or @$R.$Construction.$Valid != $AdoptSource.$Construction.$Valid">
            <!-- Changed layout data may fail differently: allow one new report. -->
            <set_value name="$R.$ConstructionError" exact="false"/>
            <debug_text text="'[CE] Construction snapshot adopted: sector=%s valid=%s'.[$Sector,$AdoptSource.$Construction.$Valid]"/>
          </do_if>
          <set_value name="$R.$Construction" exact="$AdoptSource.$Construction"/>
        </do_if>
      </actions>
    </library>
  </cues></mdscript>
