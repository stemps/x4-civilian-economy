<?xml version='1.0' encoding='utf-8'?>
<mdscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="CE_Placement" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <!-- Internal saved retry state, separate from the public hub record/snapshot. -->
    <cue name="State" namespace="this"><conditions><event_cue_signalled/></conditions></cue>
    <library name="GetState">
      <actions>
        <set_value name="$Hub" exact="$R.$Hub"/>
        <do_if value="not md.CE_Placement.State.$Sites?"><set_value name="md.CE_Placement.State.$Sites" exact="table[]"/></do_if>
        <do_if value="not md.CE_Placement.State.$Sites.{$Hub}?">
          <set_value name="md.CE_Placement.State.$Sites.{$Hub}" exact="table[$Attempts=0,$Failures=0,$NextTry=0s]"/>
        </do_if>
        <set_value name="$Placement" exact="md.CE_Placement.State.$Sites.{$Hub}"/>
        </actions>
    </library>
    <library name="Forget">
      <actions>
        <do_if value="md.CE_Placement.State.$Sites? and md.CE_Placement.State.$Sites.{$R.$Hub}?">
          <remove_value name="md.CE_Placement.State.$Sites.{$R.$Hub}"/>
        </do_if>
      </actions>
    </library>
    <library name="Prepare">
      <actions><include_actions ref="md.CE_Placement.GetState"/><set_value name="$PlacementReady" exact="player.age ge $Placement.$NextTry"/><do_if value="$PlacementReady"><set_value name="$R.$PlotReady" exact="true"/></do_if></actions></library>
    <library name="Requested">
      <actions>
        <include_actions ref="md.CE_Placement.GetState"/>
        <set_value name="$Placement.$Attempts" operation="add"/>
        <debug_text text="'[CE] Plan attempt: hub=%s level=%s attempts=%s failures=%s'.[$Hub,$R.$LayoutLevel,$Placement.$Attempts,$Placement.$Failures]"/>
      </actions>
    </library>
    <library name="Failed">
      <actions><include_actions ref="md.CE_Placement.GetState"/><set_value name="$Placement.$Failures" operation="add"/><set_value name="$Placement.$NextTry" exact="player.age + 5min"/><debug_text text="'[CE] Plan retry scheduled: hub=%s level=%s reason=%s retry_at=%s'.[$Hub,$R.$LayoutLevel,$ConstructionFailure,$Placement.$NextTry]"/></actions></library>
    <library name="Succeeded">
      <actions>
        <include_actions ref="md.CE_Placement.GetState"/>
        <debug_text text="'[CE] Plan attempt: hub=%s level=%s attempts=%s failures=%s'.[$Hub,$R.$LayoutLevel,$Placement.$Attempts,$Placement.$Failures]"/>
        <set_value name="$Placement.$Failures" exact="0"/>
        <set_value name="$Placement.$NextTry" exact="0s"/>
        <set_value name="$R.$PlotReady" exact="true"/>
      </actions>
    </library>
    </cues>
</mdscript>
