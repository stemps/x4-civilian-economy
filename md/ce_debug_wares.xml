<?xml version="1.0" encoding="utf-8"?>
<mdscript name="CE_DebugWares" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <cue name="Request" instantiate="true" namespace="this">
      <conditions><event_ui_triggered screen="'CEWareTesting'"/></conditions>
      <actions>
        <include_actions ref="md.CE_Settings.Ensure"/>
        <do_if value="md.CE_Settings.State.$Debug and md.CE_OwnerlessHub.Init.$Registry?">
          <set_value name="$Registry" exact="md.CE_OwnerlessHub.Init.$Registry"/>
          <do_for_each name="$Sector" in="$Registry.keys.list">
            <set_value name="$R" exact="$Registry.{$Sector}"/>
            <do_if value="$R.$Hub.exists and not $R.$Hub.iswreck and $R.$Hub.owner == faction.civilian and event.param3 == $R.$Hub">
              <include_actions ref="md.CE_Unrest.Ensure"/>
              <do_for_each name="$DebugWare" in="$R.$Wares.keys.list">
                <set_value name="$DebugW" exact="$R.$Wares.{$DebugWare}"/>
                <do_if value="@$DebugW.$Active and $DebugW.$Rate gt 0">
                  <do_for_each name="$DebugMode" in="['random','zero']">
                    <set_value name="$ExpectedCommand" exact="'%1:%2:%3'.[$DebugMode,$DebugWare.id,$U.$Token]"/>
                    <do_if value="event.param2 == $ExpectedCommand">
                      <set_value name="$U.$Token" operation="add"/>
                      <!-- Settle elapsed consumption before changing the current balance. -->
                      <include_actions ref="md.CE_Reserves.Accrue"/>
                      <do_if value="$DebugMode == 'zero'">
                        <set_value name="$DebugW.$Reserve" exact="0.0f"/>
                      </do_if>
                      <do_elseif value="$DebugW.$Reserve lt $DebugW.$Cap">
                        <set_value name="$DebugW.$Reserve" min="$DebugW.$Reserve" max="$DebugW.$Cap * 1.0f"/>
                      </do_elseif>
                      <include_actions ref="md.CE_Reserves.SyncAll"/>
                      <include_actions ref="md.CE_OwnerlessHub.UpdateOffers"/>
                      <include_actions ref="md.CE_Diagnostics.PublishDiagnostics"/>
                      <include_actions ref="md.CE_Diagnostics.PublishAllDiagnostics"/>
                      <debug_text text="'[CE] TEST ware: hub=%s ware=%s mode=%s reserve=%s'.[$R.$Hub,$DebugWare,$DebugMode,$DebugW.$Reserve]"/>
                      <break/>
                    </do_if>
                  </do_for_each>
                </do_if>
              </do_for_each>
            </do_if>
          </do_for_each>
        </do_if>
      </actions>
    </cue>
  </cues>
</mdscript>
