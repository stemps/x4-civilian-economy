<?xml version='1.0' encoding='UTF-8'?>
<mdscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="CE_OwnerlessHub" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <!-- Keep the old namespace so legacy saved state can be detected, never run it. -->
    <cue name="Start">
      <conditions>
        <check_value value="false"/>
      </conditions>
    </cue>
    <cue name="Init" checkinterval="1s">
      <conditions>
        <check_value value="player.age ge 1s"/>
      </conditions>
      <actions>
        <cancel_cue cue="md.CE_OwnerlessHub.WatchLevelHub"/>
        <set_value name="$Blocked" exact="md.CE_OwnerlessHub.Start.$Registry? or (player.entity.$ce_hub? and not player.entity.$ce_level_schema?)"/>
        <cancel_cue cue="md.CE_OwnerlessHub.Start"/>
        <do_if value="$Blocked">
          <debug_text text="'[CE] BLOCKED: legacy prototype save. Load a save from before Civilian Economy was installed.'"/>
          <write_to_logbook category="general" title="{974201,1}" text="{974201,30}"/>
          <set_value name="player.entity.$ce_legacy_blocked" exact="true"/>
        </do_if>
        <do_else>
          <set_value name="$Schema" exact="3"/>
          <set_value name="player.entity.$ce_level_schema" exact="$Schema"/>
          <set_value name="player.entity.$ce_legacy_blocked" exact="false"/>
          <set_value name="$PlanIDs" exact="['ce_ownerless_hub_01','ce_ownerless_hub_02','ce_ownerless_hub_03','ce_ownerless_hub_04','ce_ownerless_hub_05','ce_ownerless_hub_06','ce_ownerless_hub_07','ce_ownerless_hub_08','ce_ownerless_hub_09','ce_ownerless_hub_10']"/>
          <set_value name="$ModuleCounts" exact="[4,6,8,11,13,16,19,21,23,27]"/>
          <set_value name="$Registry" exact="table[]"/>
          <set_value name="$Sector" exact="null"/>
          <set_value name="$Hub" exact="null"/>
          <set_value name="$NextReconcile" exact="0s"/>
          <create_group groupname="$Hubs"/>
          <include_actions ref="Reconcile"/>
        </do_else>
      </actions>
      <cues>
        <cue name="LevelTick" instantiate="true" checkinterval="1min">
          <conditions>
            <check_value value="not $Blocked"/>
          </conditions>
          <actions>
            <do_if value="player.age ge $NextReconcile">
              <include_actions ref="Reconcile"/>
            </do_if>
            <do_for_each name="$Sector" in="$Registry.keys.list">
              <set_value name="$R" exact="$Registry.{$Sector}"/>
              <do_if value="$R.$Hub.exists and @$R.$WatchingHubV3 != $R.$Hub">
                <signal_cue_instantly cue="md.CE_OwnerlessHub.WatchSectorHub" param="[$Sector,$R,$R.$Hub]"/>
                <set_value name="$R.$WatchingHubV3" exact="$R.$Hub"/>
              </do_if>
              <include_actions ref="UpdateHub"/>
              <include_actions ref="PublishDiagnostics"/>
            </do_for_each>
            <include_actions ref="PublishAllDiagnostics"/>
          </actions>
        </cue>
        <cue name="Reload" instantiate="true">
          <conditions>
            <event_game_loaded/>
            <check_value value="not $Blocked"/>
          </conditions>
          <actions>
            <cancel_cue cue="md.CE_OwnerlessHub.WatchLevelHub"/>
            <include_actions ref="Reconcile"/>
            <do_for_each name="$Sector" in="$Registry.keys.list">
              <set_value name="$R" exact="$Registry.{$Sector}"/>
              <include_actions ref="RefreshProfile"/>
              <include_actions ref="RenameHub"/>
              <include_actions ref="PublishDiagnostics"/>
            </do_for_each>
            <include_actions ref="PublishAllDiagnostics"/>
          </actions>
        </cue>
        <cue name="LostHub" instantiate="true">
          <conditions>
            <event_object_destroyed group="$Hubs"/>
          </conditions>
          <actions>
            <do_if value="not $Blocked">
              <do_for_each name="$Sector" in="$Registry.keys.list">
                <set_value name="$R" exact="$Registry.{$Sector}"/>
                <do_if value="event.object == $R.$Hub">
                  <include_actions ref="ForgetHub"/>
                </do_if>
              </do_for_each>
              <include_actions ref="PublishAllDiagnostics"/>
            </do_if>
          </actions>
        </cue>
        <cue name="WatchLevelHub" instantiate="true">
          <conditions>
            <check_value value="false"/>
          </conditions>
          <actions>
            <set_value name="this.$Station" exact="$Hub"/>
          </actions>
          <cues>
            <cue name="DeliveryStarted" instantiate="true">
              <conditions>
                <event_trade_started buyer="parent.$Station"/>
                <check_value value="$R.$Wares.{event.param.ware}?"/>
                <check_value value="event.param == $R.$Wares.{event.param.ware}.$Offer"/>
                <check_value value="not $R.$Transfers.{event.param2}?"/>
              </conditions>
              <actions>
                <set_value name="this.$Deal" exact="event.param2"/>
                <set_value name="this.$Buyer" exact="event.param2.buyer"/>
                <set_value name="this.$Seller" exact="event.param2.seller"/>
                <set_value name="$R.$Transfers.{event.param2}" exact="event.param.ware"/>
                <debug_text text="'[CE] Delivery started: deal=%s ware=%s quantity=%s'.[this.$Deal, event.param.ware, this.$Deal.amount]"/>
              </actions>
              <cues>
                <cue name="DeliveryFinished">
                  <conditions>
                    <!-- Exact vanilla RML binding, one child instance per deal. -->
                    <event_trade_completed buyer="parent.$Buyer" seller="parent.$Seller"/>
                    <check_value value="event.param == parent.$Deal"/>
                    <check_value value="event.param.buyer == $R.$Hub and $R.$Transfers.{event.param}?"/>
                  </conditions>
                  <actions>
                    <include_actions ref="RecordDelivery"/>
                  </actions>
                </cue>
              </cues>
            </cue>
            <cue name="StopLevelWatch">
              <conditions>
                <event_object_destroyed object="parent.$Station"/>
              </conditions>
              <actions>
                <cancel_cue cue="parent"/>
              </actions>
            </cue>
          </cues>
        </cue>
        <cue name="TestingCommand" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'CELevelTesting'"/>
            <check_value value="not $Blocked"/>
          </conditions>
          <actions>
            <do_for_each name="$Sector" in="$Registry.keys.list">
              <set_value name="$R" exact="$Registry.{$Sector}"/>
              <do_if value="event.param3 == $R.$Hub and $R.$Hub.exists">
                <do_if value="event.param2 == 'queue_upgrade'">
                  <include_actions ref="UpdateHub"/>
                  <do_if value="$R.$Operational and $R.$Level lt 10 and $R.$Target == 0 and $R.$PlotReady">
                    <set_value name="$R.$Target" exact="$R.$Level + 1"/>
                    <set_value name="$R.$TestUpgrade" exact="true"/>
                    <debug_text text="'[CE] TEST: qualification bypass for level %s'.[$R.$Target]"/>
                    <include_actions ref="QueueExpansion"/>
                  </do_if>
                </do_if>
                <do_elseif value="event.param2 == 'pause_offers'">
                  <set_value name="$R.$PauseOffers" exact="not $R.$PauseOffers"/>
                  <include_actions ref="UpdateOffers"/>
                  <debug_text text="'[CE] TEST: new reservations paused=%s'.[$R.$PauseOffers]"/>
                </do_elseif>
                <include_actions ref="PublishDiagnostics"/>
              </do_if>
            </do_for_each>
            <include_actions ref="PublishAllDiagnostics"/>
          </actions>
        </cue>
        <cue name="WatchSectorHub" instantiate="true" namespace="this">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <actions>
            <set_value name="$Registry" exact="md.CE_OwnerlessHub.Init.$Registry"/>
            <set_value name="$Sector" exact="event.param.{1}"/>
            <set_value name="$R" exact="event.param.{2}"/>
            <set_value name="$Hub" exact="event.param.{3}"/>
            <set_value name="this.$Station" exact="$Hub"/>
          </actions>
          <cues>
            <cue name="SectorDeliveryStarted" instantiate="true">
              <conditions>
                <event_trade_started buyer="parent.$Station"/>
                <check_value value="$R.$Wares.{event.param.ware}?"/>
                <check_value value="event.param == $R.$Wares.{event.param.ware}.$Offer"/>
                <check_value value="not $R.$Transfers.{event.param2}?"/>
              </conditions>
              <actions>
                <set_value name="this.$Deal" exact="event.param2"/>
                <set_value name="this.$Buyer" exact="event.param2.buyer"/>
                <set_value name="this.$Seller" exact="event.param2.seller"/>
                <set_value name="$R.$Transfers.{event.param2}" exact="event.param.ware"/>
                <debug_text text="'[CE] Delivery started: deal=%s ware=%s quantity=%s'.[this.$Deal, event.param.ware, this.$Deal.amount]"/>
              </actions>
              <cues>
                <cue name="SectorDeliveryFinished">
                  <conditions>
                    <!-- Exact vanilla RML binding, one child instance per deal. -->
                    <event_trade_completed buyer="parent.$Buyer" seller="parent.$Seller"/>
                    <check_value value="event.param == parent.$Deal"/>
                    <check_value value="event.param.buyer == $R.$Hub and $R.$Transfers.{event.param}?"/>
                  </conditions>
                  <actions>
                    <include_actions ref="RecordDelivery"/>
                  </actions>
                </cue>
              </cues>
            </cue>
            <cue name="SectorStopLevelWatch">
              <conditions>
                <event_object_destroyed object="parent.$Station"/>
              </conditions>
              <actions>
                <cancel_cue cue="parent"/>
              </actions>
            </cue>
          </cues>
        </cue>
        <cue name="PopulationReceived" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'CEPopulation'" control="'ready'"/>
            <check_value value="not $Blocked"/>
          </conditions>
          <actions>
            <set_value name="$Response" exact="@player.entity.$ce_population_response"/>
            <do_if value="$Response and $Response.{1} == $PopulationRequest and @$PopulationApplied != $PopulationRequest">
              <set_value name="$PopulationApplied" exact="$PopulationRequest"/>
              <do_for_each name="$PopulationRow" in="$Response.{2}">
                <set_value name="$Sector" exact="$PopulationRow.{1}"/>
                <set_value name="$Population" exact="$PopulationRow.{2}"/>
                <do_if value="$Sector.exists and $Sector.isclass.sector and $Population ge 0">
                  <include_actions ref="ReconcileSector"/>
                  <do_if value="$Registry.{$Sector}?">
                    <set_value name="$R" exact="$Registry.{$Sector}"/>
                    <include_actions ref="UpdateHub"/>
                    <include_actions ref="PublishDiagnostics"/>
                  </do_if>
                </do_if>
              </do_for_each>
              <include_actions ref="PublishAllDiagnostics"/>
            </do_if>
          </actions>
        </cue>
      </cues>
    </cue>
    <library name="Reconcile">
      <actions>
        <set_value name="$NextReconcile" exact="player.age + 5min"/>
        <find_sector name="$PopulationSectors" space="player.galaxy" multiple="true"/>
        <set_value name="$PopulationRequest" exact="if $PopulationRequest? then $PopulationRequest + 1 else 1"/>
        <set_value name="player.entity.$ce_population_request" exact="[$PopulationRequest,$PopulationSectors]"/>
        <raise_lua_event name="'CEPopulationRequest'"/>
      </actions>
    </library>
    <library name="ForgetHub">
      <actions>
        <include_actions ref="md.CE_Reserves.Migrate"/>
        <include_actions ref="AccrueAll"/>
        <set_value name="$R.$Hub" exact="null"/>
        <set_value name="$Hub" exact="null"/>
        <set_value name="$R.$Operational" exact="false"/>
        <set_value name="$R.$PauseReason" exact="'hub_unavailable'"/>
        <set_value name="$R.$Target" exact="0"/>
        <set_value name="$R.$Build" exact="null"/>
        <set_value name="$R.$PlotReady" exact="false"/>
        <set_value name="$R.$InitializedHub" exact="null"/>
        <set_value name="$R.$TestUpgrade" exact="false"/>
        <clear_table table="$R.$Transfers"/>
        <do_for_each name="$Ware" in="$R.$Wares.keys.list">
          <set_value name="$R.$Wares.{$Ware}.$Offer" exact="null"/>
          <set_value name="$R.$Wares.{$Ware}.$Reserve" exact="0.0f"/>
        </do_for_each>
        <include_actions ref="ResetHistory"/>
        <include_actions ref="PublishDiagnostics"/>
        <debug_text text="'[CE] Hub lost: reserves lost; retained level, growth and counters; discarded pending expansion'"/>
      </actions>
    </library>
    <library name="RefreshProfile">
      <actions>
        <include_actions ref="md.CE_Reserves.Migrate"/>
        <!-- Requires R and Sector. Preparation has no writes to R. -->
        <set_value name="$CandidateComplete" exact="false"/>
        <set_value name="$CandidateStage" exact="'start'"/>
        <include_actions ref="md.CE_PopulationProfiles.Build"/>
        <do_if value="$CandidateComplete and $CandidateValid">
          <set_value name="$CandidateRatesComplete" exact="false"/>
          <include_actions ref="PrepareRates"/>
        </do_if>
        <do_if value="$CandidateComplete and $CandidateValid and $CandidateRatesComplete">
          <set_value name="$ProfileChanged" exact="not $R.$Definitions?"/>
          <set_value name="$PreviousDefinitions" exact="table[]"/>
          <do_if value="$R.$Definitions?">
            <do_for_each name="$Definition" in="$R.$Definitions">
              <set_value name="$Ware" exact="$Definition.{1}"/>
              <set_value name="$PreviousDefinitions.{$Ware}" exact="$Definition"/>
            </do_for_each>
          </do_if>
          <do_if value="$PreviousDefinitions.keys.count != $CandidateDefinitions.count">
            <set_value name="$ProfileChanged" exact="true"/>
          </do_if>
          <do_for_each name="$Definition" in="$CandidateDefinitions">
            <set_value name="$Ware" exact="$Definition.{1}"/>
            <do_if value="not $PreviousDefinitions.{$Ware}?">
              <set_value name="$ProfileChanged" exact="true"/>
            </do_if>
            <do_elseif value="$PreviousDefinitions.{$Ware}.{2} != $Definition.{2} or $PreviousDefinitions.{$Ware}.{3} != $Definition.{3}">
              <set_value name="$ProfileChanged" exact="true"/>
            </do_elseif>
          </do_for_each>
          <do_if value="$ProfileChanged and $R.$Last?">
            <include_actions ref="AccrueAll"/>
          </do_if>
          <set_value name="$R.$Definitions" exact="$CandidateDefinitions"/>
          <set_value name="$R.$ProfileRace" exact="$CandidateRace"/>
          <set_value name="$R.$ProfileVersion" exact="2"/>
          <do_if value="$ProfileChanged">
            <include_actions ref="CommitRates"/>
          </do_if>
          <include_actions ref="EnsureDisplayMetadata"/>
          <do_if value="@$R.$ProfileError">
            <debug_text text="'[CE] Profile recovered: %s'.[$R.$Hub]"/>
          </do_if>
          <set_value name="$R.$ProfileError" exact="false"/>
        </do_if>
        <do_else>
          <do_if value="not @$R.$ProfileError or @$R.$ProfileErrorStage != $CandidateStage">
            <debug_text text="'[CE] Profile refresh failed: hub=%s sector=%s stage=%s; retaining last valid state'.[$R.$Hub,$Sector,$CandidateStage]"/>
          </do_if>
          <set_value name="$R.$ProfileError" exact="true"/>
          <set_value name="$R.$ProfileErrorStage" exact="$CandidateStage"/>
        </do_else>
      </actions>
    </library>
    <library name="ApplyLevel">
      <actions>
        <include_actions ref="md.CE_Reserves.Migrate"/>
        <!-- Level/population changes use committed definitions, never rebuild profiles. -->
        <do_if value="$R.$Definitions?">
          <set_value name="$CandidateDefinitions" exact="$R.$Definitions"/>
          <set_value name="$CandidateValid" exact="true"/>
          <set_value name="$CandidateRatesComplete" exact="false"/>
          <include_actions ref="PrepareRates"/>
          <do_if value="$CandidateValid and $CandidateRatesComplete">
            <include_actions ref="CommitRates"/>
          </do_if>
        </do_if>
        <do_else>
          <include_actions ref="RefreshProfile"/>
        </do_else>
      </actions>
    </library>
    <library name="ResetHistory">
      <actions>
        <include_actions ref="md.CE_Reserves.Rebase"/>
      </actions>
    </library>
    <library name="AccrueAll">
      <actions>
        <include_actions ref="md.CE_Reserves.Accrue"/>
      </actions>
    </library>
    <library name="EvaluateQualification">
      <actions>
        <include_actions ref="md.CE_Reserves.Qualify"/>
      </actions>
    </library>
    <library name="RecordDelivery">
      <actions>
        <include_actions ref="AccrueAll"/>
        <set_value name="$Ware" exact="$R.$Transfers.{event.param}"/>
        <set_value name="$W" exact="$R.$Wares.{$Ware}"/>
        <set_value name="$Delivered" exact="event.param.transferredamount"/>
        <!-- Consume guard before any work that can publish or signal. -->
        <remove_value name="$R.$Transfers.{event.param}"/>
        <set_value name="$W.$Reserve" exact="$Delivered" operation="add"/>
        <set_value name="$ReserveState" exact="$W"/>
        <include_actions ref="md.CE_Reserves.SyncWare"/>
        <set_value name="$W.$Delivered" operation="add" exact="$Delivered"/>
        <set_value name="$W.$Paid" operation="add" exact="$Delivered * event.param.unitprice"/>
        <debug_text text="'[CE] Completed delivery: ware=%s amount=%s paid=%s reserve=%s delivered_total=%s'.[$Ware,$Delivered,$Delivered * event.param.unitprice,$W.$Reserve,$W.$Delivered]"/>
        <include_actions ref="UpdateOffers"/>
        <include_actions ref="PublishDiagnostics"/>
        <include_actions ref="PublishAllDiagnostics"/>
      </actions>
    </library>
    <library name="UpdateHub">
      <actions>
        <include_actions ref="md.CE_Reserves.Migrate"/>
        <set_value name="$Hub" exact="$R.$Hub"/>
        <set_value name="$Ready" exact="false"/>
        <set_value name="$TargetReady" exact="false"/>
        <set_value name="$R.$PauseReason" exact="'hub_unavailable'"/>
        <do_if value="$Hub.exists and not $Hub.iswreck and $Hub.owner != faction.ownerless">
          <set_value name="$R.$PauseReason" exact="'owner_changed'"/>
        </do_if>
        <do_if value="$Hub.exists and not $Hub.iswreck and $Hub.owner == faction.ownerless">
          <set_value name="$Sequence" exact="$Hub.constructionsequence"/>
          <set_value name="$Required" exact="$ModuleCounts.{$R.$Level}"/>
          <set_value name="$Ready" exact="$Sequence.count ge $Required and (not $R.$Population? or $R.$Population gt 0) and $R.$Definitions?"/>
          <set_value name="$Constructing" exact="$Sequence.count lt $Required"/>
          <set_value name="$Damaged" exact="false"/>
          <do_all exact="[$Required,$Sequence.count].min" counter="$i">
            <do_if value="not @$Hub.planmodule.{$Sequence.{$i}.id}.isoperational">
              <set_value name="$Ready" exact="false"/>
              <do_if value="@$Hub.planmodule.{$Sequence.{$i}.id}.iswreck">
                <set_value name="$Damaged" exact="true"/>
              </do_if>
              <do_elseif value="not @$Hub.planmodule.{$Sequence.{$i}.id}.exists or @$Hub.planmodule.{$Sequence.{$i}.id}.isconstruction">
                <set_value name="$Constructing" exact="true"/>
              </do_elseif>
            </do_if>
          </do_all>
          <!-- Presentation only: retain the readiness/qualification rules above. -->
          <set_value name="$R.$PauseReason" exact="if $Ready then 'active' else if $Damaged then 'damaged_modules' else if $Constructing then 'constructing' else if $R.$Population? and $R.$Population == 0 then 'no_population' else 'modules_unavailable'"/>
          <do_if value="$R.$Target gt 0">
            <set_value name="$TargetCount" exact="$ModuleCounts.{$R.$Target}"/>
            <set_value name="$TargetReady" exact="$Ready and $Sequence.count ge $TargetCount"/>
            <do_all exact="[$TargetCount,$Sequence.count].min" counter="$i">
              <do_if value="not @$Hub.planmodule.{$Sequence.{$i}.id}.isoperational">
                <set_value name="$TargetReady" exact="false"/>
              </do_if>
            </do_all>
          </do_if>
        </do_if>
        <do_if value="$Ready">
          <do_if value="not $R.$Operational">
            <include_actions ref="ResetHistory"/>
            <set_value name="$R.$Operational" exact="true"/>
            <do_if value="$R.$InitializedHub != $Hub">
              <signal_objects object="player.galaxy" param="'init station'" param2="$Hub" param3="false"/>
              <set_value name="$R.$InitializedHub" exact="$Hub"/>
            </do_if>
            <debug_text text="'[CE] Completed-level modules operational: level=%s'.[$R.$Level]"/>
          </do_if>
          <include_actions ref="AccrueAll"/>
          <do_if value="$TargetReady">
            <set_value name="$R.$Level" exact="$R.$Target"/>
            <set_value name="$R.$GrowthSeconds" exact="0.0f"/>
            <set_value name="$R.$Target" exact="0"/>
            <set_value name="$R.$Build" exact="null"/>
            <debug_text text="'[CE] Upgrade completed: level=%s qualification_bypassed=%s'.[$R.$Level,$R.$TestUpgrade]"/>
            <set_value name="$R.$TestUpgrade" exact="false"/>
            <include_actions ref="ApplyLevel"/>
            <include_actions ref="RenameHub"/>
          </do_if>
          <set_value name="$ManagedObject" exact="$Hub"/>
          <include_actions ref="EnsureManager"/>
          <include_actions ref="FundAccounts"/>
          <include_actions ref="EvaluateQualification"/>
          <do_if value="$R.$Qualified and $R.$PlotReady">
            <set_value name="$R.$Target" exact="$R.$Level + 1"/>
            <set_value name="$R.$TestUpgrade" exact="false"/>
            <debug_text text="'[CE] Naturally qualified for level %s'.[$R.$Target]"/>
            <include_actions ref="QueueExpansion"/>
          </do_if>
        </do_if>
        <do_else>
          <do_if value="$R.$Operational">
            <debug_text text="'[CE] Required modules unavailable: consumption and growth paused; progress preserved'"/>
          </do_if>
          <set_value name="$R.$Operational" exact="false"/>
          <include_actions ref="ResetHistory"/>
          <do_if value="$Hub.exists and not $Hub.iswreck">
            <include_actions ref="FundAccounts"/>
          </do_if>
        </do_else>
        <include_actions ref="UpdateOffers"/>
      </actions>
    </library>
    <library name="ReserveGrowthPlot">
      <actions>
        <!-- buildplot.max is the half-size about buildplot.center. The safety
             action takes incremental growth, not final dimensions. Never shrink. -->
        <set_value name="$PlotMax" exact="$Hub.buildplot.max"/>
        <set_value name="$PlotCenter" exact="$Hub.buildplot.center"/>
        <set_value name="$GrowNegX" exact="[0m,6km + $PlotCenter.x - $PlotMax.x].max"/>
        <set_value name="$GrowPosX" exact="[0m,6km - $PlotCenter.x - $PlotMax.x].max"/>
        <set_value name="$GrowNegY" exact="[0m,4km + $PlotCenter.y - $PlotMax.y].max"/>
        <set_value name="$GrowPosY" exact="[0m,4km - $PlotCenter.y - $PlotMax.y].max"/>
        <set_value name="$GrowNegZ" exact="[0m,16km + $PlotCenter.z - $PlotMax.z].max"/>
        <set_value name="$GrowPosZ" exact="[0m,16km - $PlotCenter.z - $PlotMax.z].max"/>
        <do_if value="$GrowNegX + $GrowPosX + $GrowNegY + $GrowPosY + $GrowNegZ + $GrowPosZ == 0m">
          <set_value name="$R.$PlotReady" exact="true"/>
        </do_if>
        <do_else>
          <can_safely_extend_build_plot object="$Hub" negx="$GrowNegX" posx="$GrowPosX" negy="$GrowNegY" posy="$GrowPosY" negz="$GrowNegZ" posz="$GrowPosZ" result="$SafePlot"/>
          <do_if value="$SafePlot">
            <extend_build_plot object="$Hub" negx="$GrowNegX" posx="$GrowPosX" negy="$GrowNegY" posy="$GrowPosY" negz="$GrowNegZ" posz="$GrowPosZ"/>
            <set_value name="$PlotMax" exact="$Hub.buildplot.max"/>
            <set_value name="$PlotCenter" exact="$Hub.buildplot.center"/>
            <set_value name="$R.$PlotReady" exact="$PlotMax.x - $PlotCenter.x ge 6km and $PlotMax.x + $PlotCenter.x ge 6km and $PlotMax.y - $PlotCenter.y ge 4km and $PlotMax.y + $PlotCenter.y ge 4km and $PlotMax.z - $PlotCenter.z ge 16km and $PlotMax.z + $PlotCenter.z ge 16km"/>
          </do_if>
        </do_else>
        <do_if value="$R.$PlotReady">
          <debug_text text="'[CE] Growth plot ready: half-size=%s center=%s'.[$PlotMax,$PlotCenter]"/>
        </do_if>
        <do_else>
          <debug_text text="'[CE] BLOCKED growth plot: half-size=%s center=%s additional neg=%s/%s/%s pos=%s/%s/%s'.[$PlotMax,$PlotCenter,$GrowNegX,$GrowNegY,$GrowNegZ,$GrowPosX,$GrowPosY,$GrowPosZ]"/>
        </do_else>
      </actions>
    </library>
    <library name="QueueExpansion">
      <actions>
        <set_value name="$Hub" exact="$R.$Hub"/>
        <do_if value="$R.$Target gt 0 and $R.$PlotReady and $Hub.exists and $Hub.buildstorage.exists and not $R.$Build.exists">
          <!-- Never append while another native build is queued or processing. -->
          <do_if value="$Hub.buildstorage.builds.queued.count + $Hub.buildstorage.builds.inprogress.count == 0">
            <add_build_to_expand_station result="$R.$Build" object="$Hub.buildstorage" buildobject="$Hub" constructionplan="$PlanIDs.{$R.$Target}">
              <stage exact="0"/>
            </add_build_to_expand_station>
            <do_if value="$R.$Build.exists">
              <process_build build="$R.$Build" object="$Hub.buildstorage" buildmodule="$Hub.buildstorage.buildmodule"/>
              <include_actions ref="FundAccounts"/>
              <include_actions ref="AssignBuilder"/>
              <debug_text text="'[CE] Expansion queued: current=%s target=%s task=%s'.[$R.$Level,$R.$Target,$R.$Build]"/>
            </do_if>
          </do_if>
        </do_if>
      </actions>
    </library>
    <library name="UpdateWarePrice">
      <actions>
        <set_value name="$RawPrice" exact="$Ware.minprice + ($Ware.maxprice - $Ware.minprice) / 10"/>
        <set_value name="$W.$Price" exact="(($RawPrice / 1Cr)i) * 1Cr"/>
        <do_if value="$W.$Price lt $RawPrice">
          <set_value name="$W.$Price" operation="add" exact="1Cr"/>
        </do_if>
      </actions>
    </library>
    <library name="UpdateOffers">
      <actions>
        <include_actions ref="md.CE_Reserves.Migrate"/>
        <set_value name="$Hub" exact="$R.$Hub"/>
        <do_for_each name="$Deal" in="$R.$Transfers.keys.list" reverse="true">
          <do_if value="not $Deal.exists">
            <remove_value name="$R.$Transfers.{$Deal}"/>
          </do_if>
        </do_for_each>
        <do_for_each name="$Ware" in="$R.$Wares.keys.list">
          <set_value name="$W" exact="$R.$Wares.{$Ware}"/>
          <set_value name="$Unloading" exact="false"/>
          <do_for_each name="$Deal" in="$R.$Transfers.keys.list">
            <do_if value="$R.$Transfers.{$Deal} == $Ware">
              <set_value name="$Unloading" exact="true"/>
            </do_if>
          </do_for_each>
          <do_if value="not $Unloading and $Hub.exists and not $Hub.iswreck">
            <!-- Retired wares keep their last price and accounting record. -->
            <do_if value="$W.$Rate gt 0">
              <include_actions ref="UpdateWarePrice"/>
            </do_if>
            <set_value name="$Desired" exact="if $W.$Rate gt 0 then ($W.$Demand)i else 0"/>
            <do_if value="$W.$Offer.exists">
              <set_value name="$Reserved" exact="[0,$W.$Offer.offeramount - $W.$Offer.amount].max"/>
              <set_value name="$Available" exact="if $R.$Operational and not $R.$PauseOffers then [0,$Desired - $Reserved].max else 0"/>
              <update_trade trade="$W.$Offer" amount="$Available" desiredamount="$Desired" price="$W.$Price"/>
            </do_if>
            <do_elseif value="$Desired gt 0 and $R.$Operational and not $R.$PauseOffers">
              <create_trade_offer name="$W.$Offer" object="$Hub" buyer="$Hub" ware="$Ware" amount="$Desired" desiredamount="$Desired" price="$W.$Price" virtual="true" virtualmoney="false" playeronly="false"/>
            </do_elseif>
          </do_if>
        </do_for_each>
      </actions>
    </library>
    <library name="FundAccounts">
      <actions>
        <set_value name="$Hub" exact="$R.$Hub"/>
        <do_if value="$Hub.isclass.container">
          <set_object_account object="$Hub"/>
          <set_value name="$TargetMoney" exact="0Cr"/>
          <do_for_each name="$Ware" in="$R.$Wares.keys.list">
            <set_value name="$TargetMoney" operation="add" exact="$R.$Wares.{$Ware}.$Cap * $R.$Wares.{$Ware}.$Price * 2"/>
          </do_for_each>
          <do_if value="$Hub.money lt $TargetMoney">
            <transfer_money from="faction.ownerless" to="$Hub" amount="$TargetMoney - $Hub.money" result="$Funded"/>
            <debug_text text="'[CE] Civilian funding=%s balance=%s'.[$Funded,$Hub.money]"/>
          </do_if>
        </do_if>
        <do_if value="$Hub.buildstorage.exists">
          <set_value name="$ManagedObject" exact="$Hub.buildstorage"/>
          <include_actions ref="EnsureManager"/>
          <set_object_account object="$Hub.buildstorage"/>
          <set_value name="$BuildBudget" exact="$Hub.buildstorage.wantedmoney"/>
          <do_if value="$BuildBudget gt $Hub.buildstorage.money">
            <transfer_money from="faction.ownerless" to="$Hub.buildstorage" amount="$BuildBudget - $Hub.buildstorage.money" result="$Funded"/>
            <debug_text text="'[CE] Construction funding=%s budget=%s'.[$Funded,$BuildBudget]"/>
          </do_if>
        </do_if>
      </actions>
    </library>
    <library name="RenameHub">
      <actions>
        <do_if value="$R.$Hub.exists and not $R.$Hub.iswreck">
          <set_object_name object="$R.$Hub" name="{974201,31}.[$Sector.knownname,$R.$Level]"/>
        </do_if>
      </actions>
    </library>
    <library name="PublishDiagnostics">
      <actions>
        <include_actions ref="md.CE_Reserves.Migrate"/>
        <include_actions ref="EnsureDisplayMetadata"/>
        <set_value name="$SnapshotValid" exact="true"/>
        <do_if value="not ($R.$Level? and $R.$Target? and $R.$Operational? and $R.$GrowthSeconds? and $R.$PauseOffers? and $R.$PlotReady? and $R.$TestUpgrade?)">
          <set_value name="$SnapshotValid" exact="false"/>
        </do_if>
        <set_value name="$Rows" exact="[]"/>
        <!-- Presentation reads committed demand records, never rebuilds a profile. -->
        <set_value name="$SnapshotSeen" exact="table[]"/>
        <set_value name="$ActiveCount" exact="0"/>
        <do_for_each name="$Ware" in="$R.$Wares.keys.list">
          <do_if value="@$R.$Wares.{$Ware}.$Active">
            <set_value name="$ActiveCount" operation="add"/>
          </do_if>
        </do_for_each>
        <do_if value="not $R.$Definitions? and $ActiveCount == 0">
          <set_value name="$SnapshotValid" exact="false"/>
        </do_if>
        <do_for_each name="$Ware" in="$R.$DisplayOrder">
          <do_if value="$SnapshotSeen.{$Ware}?">
            <set_value name="$SnapshotValid" exact="false"/>
          </do_if>
          <set_value name="$SnapshotSeen.{$Ware}" exact="true"/>
          <do_if value="$R.$Wares.{$Ware}? and $R.$Wares.{$Ware}.$Active">
            <set_value name="$W" exact="$R.$Wares.{$Ware}"/>
            <do_if value="not ($W.$Reserve? and $W.$Cap? and $W.$Rate? and $W.$Delivered? and $W.$Paid?)">
              <set_value name="$SnapshotValid" exact="false"/>
            </do_if>
            <do_if value="not ($W.$Reserve ge 0 and $W.$Cap ge 0 and $W.$Rate ge 0 and $W.$Delivered ge 0 and $W.$Paid ge 0Cr)">
              <set_value name="$SnapshotValid" exact="false"/>
            </do_if>
            <set_value name="$Available" exact="0"/>
            <set_value name="$Reserved" exact="0"/>
            <do_if value="$W.$Offer.exists">
              <set_value name="$Available" exact="$W.$Offer.amount"/>
              <set_value name="$Reserved" exact="[0,$W.$Offer.offeramount - $Available].max"/>
            </do_if>
            <set_value name="$RemainingSeconds" exact="if $W.$Rate gt 0 then $W.$Reserve * 3600.0f / $W.$Rate else 0.0f"/>
            <append_to_list name="$Rows" exact="[$Ware.name,$W.$Reserve,$W.$Cap,$Available,$Reserved,$W.$Delivered,$W.$Paid / 1Cr,$RemainingSeconds,$W.$Rate,$Ware.id]"/>
          </do_if>
        </do_for_each>
        <do_if value="$Rows.count != $R.$DisplayOrder.count or $Rows.count != $ActiveCount">
          <set_value name="$SnapshotValid" exact="false"/>
        </do_if>
        <do_if value="$SnapshotValid">
          <set_value name="$Unlocks" exact="[]"/>
          <do_if value="$R.$Definitions?">
            <do_for_each name="$NextDefinition" in="$R.$Definitions">
              <do_if value="$NextDefinition.{2} == $R.$Level + 1">
                <append_to_list name="$Unlocks" exact="$NextDefinition.{1}.name"/>
              </do_if>
            </do_for_each>
          </do_if>
          <set_value name="$R.$Snapshot" exact="[$R.$Hub,$R.$Level,$R.$Target,$R.$Operational,$R.$GrowthSeconds,($R.$Level + 1) * 3600.0f,$R.$PauseOffers,$R.$PlotReady,$Rows,$R.$TestUpgrade,@$R.$Population,@$R.$PauseReason,3,@$R.$ProfileError,false,$Unlocks]"/>
          <do_if value="@$R.$SnapshotError">
            <debug_text text="'[CE] Details recovered: %s'.[$R.$Hub]"/>
          </do_if>
          <set_value name="$R.$SnapshotError" exact="false"/>
        </do_if>
        <do_else>
          <do_if value="not @$R.$SnapshotError">
            <debug_text text="'[CE] Details refresh failed: hub=%s stage=rows; retaining previous snapshot'.[$R.$Hub]"/>
          </do_if>
          <set_value name="$R.$SnapshotError" exact="true"/>
          <do_if value="$R.$Snapshot?">
            <set_value name="$R.$Snapshot" exact="[$R.$Snapshot.{1},$R.$Snapshot.{2},$R.$Snapshot.{3},$R.$Snapshot.{4},$R.$Snapshot.{5},$R.$Snapshot.{6},$R.$Snapshot.{7},$R.$Snapshot.{8},$R.$Snapshot.{9},$R.$Snapshot.{10},@$R.$Snapshot.{11},@$R.$Snapshot.{12},@$R.$Snapshot.{13},@$R.$ProfileError,true,@$R.$Snapshot.{16}]"/>
          </do_if>
        </do_else>
      </actions>
    </library>
    <library xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="AssignBuilder">
      <actions>
        <do_if value="$Hub.buildstorage.exists and $Hub.buildstorage.buildmodule.exists and ($Hub.buildstorage.builds.queued.count + $Hub.buildstorage.builds.inprogress.count) gt 0 and not $Hub.buildstorage.buildmodule.constructionvessel.exists">
          <find_ship name="$Builders" space="player.galaxy" primarypurpose="purpose.build" class="class.ship_xl" multiple="true" checkoperational="true"/>
          <set_value name="$Candidates" exact="[]"/>
          <set_value name="$Nearest" exact="100000"/>
          <do_for_each name="$Builder" in="$Builders">
            <do_if value="not $Builder.isplayerowned and $Builder.pilot.exists and not $Builder.constructionmodule.exists and $Builder.order.id == 'FindBuildTasks' and not $Builder.nextorder">
              <do_if value="(not $Sector.owner or $Sector.owner == faction.ownerless or not $Builder.owner.hasrelation.enemy.{$Sector.owner}) and $Hub.hasrelation.dock.{$Builder}">
                <set_value name="$Distance" exact="$Builder.gatedistance.{$Hub}"/>
                <do_if value="$Distance ge 0 and $Distance le $Nearest">
                  <do_if value="$Distance lt $Nearest">
                    <set_value name="$Candidates" exact="[]"/>
                    <set_value name="$Nearest" exact="$Distance"/>
                  </do_if>
                  <append_to_list name="$Candidates" exact="$Builder"/>
                </do_if>
              </do_if>
            </do_if>
          </do_for_each>
          <do_if value="$Candidates.count">
            <set_value name="$Builder" exact="$Candidates.random"/>
            <assign_construction_vessel object="$Builder" buildmodule="$Hub.buildstorage.buildmodule"/>
            <create_order object="$Builder" id="'DeployToStation'" immediate="true">
              <param name="station" value="$Hub"/>
              <param name="waitduration" value="5min"/>
              <param name="abandonbuildtime" value="1h"/>
            </create_order>
            <debug_text text="'[CE] Builder assigned=%s gate_distance=%s'.[$Builder, $Nearest]"/>
          </do_if>
          <do_else>
            <debug_text text="'[CE] Waiting for an idle, non-hostile NPC builder; retry in five minutes'"/>
          </do_else>
        </do_if>
      </actions>
    </library>
    <library xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="EnsureManager">
      <actions>
        <do_if value="$ManagedObject.isoperational and not $ManagedObject.tradenpc.exists">
          <!-- Explicit appearance avoids ownerless.primaryrace lookup; ownership stays ownerless. -->
          <create_cue_actor name="$Manager" cue="md.CE_OwnerlessHub.Init">
            <select faction="faction.argon" tags="controlpost.manager.tag"/>
            <owner exact="faction.ownerless"/>
          </create_cue_actor>
          <do_if value="$Manager">
            <assign_control_entity object="$ManagedObject" actor="$Manager" post="controlpost.manager" transfer="true"/>
            <remove_cue_actor actor="$Manager" cue="md.CE_OwnerlessHub.Init"/>
            <create_ai_unit object="$ManagedObject"/>
            <debug_text text="'[CE] Ownerless manager initialised on %s'.[$ManagedObject]"/>
          </do_if>
          <do_else>
            <debug_text text="'[CE] BLOCKED: could not create ownerless manager on %s'.[$ManagedObject]"/>
          </do_else>
        </do_if>
      </actions>
    </library>
    <library name="ReconcileSector">
      <actions>
        <do_if value="$Sector and ($Population ge 100000000 or $Registry.{$Sector}?)">
          <do_if value="not $Registry.{$Sector}?">
            <set_value name="$Registry.{$Sector}" exact="table[$Hub=null,$Level=1,$Target=0,$Build=null,$Operational=false,$Wares=table[],$Transfers=table[],$Generation=0,$PauseOffers=false,$TestUpgrade=false,$PlotReady=false,$InitializedHub=null,$Population=$Population,$Factor=$Population / 8524100000.0f]"/>
            <set_value name="$R" exact="$Registry.{$Sector}"/>
          </do_if>
          <set_value name="$R" exact="$Registry.{$Sector}"/>
          <include_actions ref="UpdatePopulation"/>
          <include_actions ref="RefreshProfile"/>
          <do_if value="(not $R.$Hub.exists or $R.$Hub.iswreck) and $Population ge 100000000">
            <do_if value="$R.$Hub != null">
              <include_actions ref="ForgetHub"/>
            </do_if>
            <do_if value="@player.entity.$ce_hub.exists and not player.entity.$ce_hub.iswreck and player.entity.$ce_hub.sector == $Sector">
              <set_value name="$R.$Hub" exact="player.entity.$ce_hub"/>
            </do_if>
            <do_else>
              <create_station name="$NewHub" macro="macro.ce_civilian_hub_macro" constructionplan="$PlanIDs.{$R.$Level}" owner="faction.ownerless" sector="$Sector" state="componentstate.construction" rawname="'{974201,1}'" rawdescription="'{974201,2}'" method="default">
                <safepos x="$Sector.coreposition.x + 50km" y="0m" z="$Sector.coreposition.z" radius="20km" includeplotbox="true" allowyaxis="false"/>
                <stage exact="0"/>
              </create_station>
              <do_if value="$NewHub.exists">
                <set_value name="$R.$Hub" exact="$NewHub"/>
                <set_value name="$R.$Generation" operation="add"/>
                <set_value name="$R.$PlotReady" exact="false"/>
                <include_actions ref="ResetHistory"/>
                <debug_text text="'[CE] Construction site created: %s earned_level=%s generation=%s'.[$NewHub,$R.$Level,$R.$Generation]"/>
              </do_if>
            </do_else>
          </do_if>
          <set_value name="$Hub" exact="$R.$Hub"/>
          <do_if value="$Hub.exists and not $Hub.iswreck and $Hub.owner == faction.ownerless">
            <add_to_group groupname="$Hubs" object="$Hub"/>
            <do_if value="not $R.$PlotReady and $Hub.isclass.container">
              <include_actions ref="ReserveGrowthPlot"/>
            </do_if>
            <include_actions ref="RenameHub"/>
            <include_actions ref="FundAccounts"/>
            <include_actions ref="QueueExpansion"/>
            <do_if value="@$Hub.buildstorage.builds.queued.{1}">
              <process_build build="$Hub.buildstorage.builds.queued.{1}" object="$Hub.buildstorage" buildmodule="$Hub.buildstorage.buildmodule"/>
            </do_if>
            <include_actions ref="AssignBuilder"/>
            <debug_text text="'[CE] Reconcile: level=%s target=%s queued=%s inprogress=%s builder=%s'.[$R.$Level,$R.$Target,@$Hub.buildstorage.builds.queued.count,@$Hub.buildstorage.builds.inprogress.count,@$Hub.buildstorage.buildmodule.constructionvessel]"/>
          </do_if>
        </do_if>
      </actions>
    </library>
    <library name="UpdatePopulation">
      <actions>
        <do_if value="not $R.$Population? or $R.$Population != $Population">
          <include_actions ref="AccrueAll"/>
          <set_value name="$R.$Population" exact="$Population"/>
          <set_value name="$R.$Factor" exact="$Population / 8524100000.0f"/>
          <include_actions ref="ApplyLevel"/>
          <debug_text text="'[CE] Population: sector=%s accessible=%s demand_factor=%s'.[$Sector.knownname,$Population,$R.$Factor]"/>
        </do_if>
      </actions>
    </library>
    <library name="PublishAllDiagnostics">
      <actions>
        <set_value name="$HubList" exact="[]"/>
        <set_value name="$Snapshots" exact="[]"/>
        <do_for_each name="$RegisteredSector" in="$Registry.keys.list">
          <set_value name="$Registered" exact="$Registry.{$RegisteredSector}"/>
          <do_if value="$Registered.$Hub.exists and not $Registered.$Hub.iswreck">
            <append_to_list name="$HubList" exact="$Registered.$Hub"/>
            <do_if value="$Registered.$Snapshot?">
              <append_to_list name="$Snapshots" exact="$Registered.$Snapshot"/>
            </do_if>
          </do_if>
        </do_for_each>
        <set_value name="player.entity.$ce_hubs" exact="$HubList"/>
        <set_value name="player.entity.$ce_hub_statuses" exact="$Snapshots"/>
      </actions>
    </library>
    <library name="PrepareRates">
      <actions>
        <set_value name="$CandidateStage" exact="'rates'"/>
        <set_value name="$CandidateRates" exact="[]"/>
        <set_value name="$CandidateSeen" exact="table[]"/>
        <set_value name="$CandidateChecked" exact="0"/>
        <do_for_each name="$Definition" in="$CandidateDefinitions">
          <set_value name="$Ware" exact="$Definition.{1}"/>
          <do_if value="$CandidateSeen.{$Ware}? or $Definition.{2} lt 1 or $Definition.{2} gt 10 or $Definition.{2} != ($Definition.{2})i or not ($Definition.{3} gt 0 and $Definition.{3} le 1000000000000.0f)">
            <set_value name="$CandidateValid" exact="false"/>
          </do_if>
          <set_value name="$CandidateSeen.{$Ware}" exact="true"/>
          <do_if value="$Definition.{2} le $R.$Level">
            <set_value name="$Rate" exact="$Definition.{3}"/>
            <do_if value="$R.$Factor?">
              <set_value name="$Rate" exact="$Rate * $R.$Factor"/>
            </do_if>
            <do_all exact="$R.$Level - $Definition.{2}">
              <set_value name="$Rate" exact="$Rate * 1.25f"/>
            </do_all>
            <do_if value="not ($Rate ge 0 and $Rate le 1000000000000.0f)">
              <set_value name="$CandidateValid" exact="false"/>
            </do_if>
            <set_value name="$W" exact="table[]"/>
            <include_actions ref="UpdateWarePrice"/>
            <do_if value="not $W.$Price? or not ($W.$Price ge 0Cr)">
              <set_value name="$CandidateValid" exact="false"/>
            </do_if>
            <append_to_list name="$CandidateRates" exact="[$Ware,$Rate,$Rate * 2,$W.$Price]"/>
          </do_if>
          <set_value name="$CandidateChecked" operation="add"/>
        </do_for_each>
        <do_if value="$CandidateChecked != $CandidateDefinitions.count">
          <set_value name="$CandidateValid" exact="false"/>
        </do_if>
        <set_value name="$CandidateRatesComplete" exact="true"/>
      </actions>
    </library>
    <library name="CommitRates">
      <actions>
        <!-- Synchronous commit of validated rates; keep record/offer/deal identities. -->
        <set_value name="$R.$DisplayOrder" exact="[]"/>
        <do_for_each name="$Ware" in="$R.$Wares.keys.list">
          <set_value name="$R.$Wares.{$Ware}.$Active" exact="false"/>
          <set_value name="$R.$Wares.{$Ware}.$Rate" exact="0.0f"/>
          <set_value name="$R.$Wares.{$Ware}.$Cap" exact="0.0f"/>
        </do_for_each>
        <do_for_each name="$Entry" in="$CandidateRates">
          <set_value name="$Ware" exact="$Entry.{1}"/>
          <do_if value="not $R.$Wares.{$Ware}?">
            <set_value name="$R.$Wares.{$Ware}" exact="table[$Reserve=0.0f,$Demand=0.0f,$Offer=null,$Delivered=0,$Paid=0Cr]"/>
          </do_if>
          <set_value name="$W" exact="$R.$Wares.{$Ware}"/>
          <set_value name="$W.$Active" exact="true"/>
          <set_value name="$W.$Rate" exact="$Entry.{2}"/>
          <set_value name="$W.$Cap" exact="$Entry.{3}"/>
          <set_value name="$W.$Price" exact="$Entry.{4}"/>
          <append_to_list name="$R.$DisplayOrder" exact="$Ware"/>
        </do_for_each>
        <include_actions ref="ResetHistory"/>
      </actions>
    </library>
    <library name="EnsureDisplayMetadata">
      <actions>
        <!-- Save migration only. Never recompute rates or reset progress for presentation. -->
        <do_if value="not $R.$DisplayOrder?">
          <set_value name="$R.$DisplayOrder" exact="[]"/>
          <do_for_each name="$Ware" in="$R.$Wares.keys.list">
            <set_value name="$R.$Wares.{$Ware}.$Active" exact="false"/>
          </do_for_each>
          <do_if value="$R.$Definitions?">
            <do_for_each name="$Definition" in="$R.$Definitions">
              <set_value name="$Ware" exact="$Definition.{1}"/>
              <do_if value="$Definition.{2} le $R.$Level and $R.$Wares.{$Ware}?">
                <set_value name="$R.$Wares.{$Ware}.$Active" exact="true"/>
                <append_to_list name="$R.$DisplayOrder" exact="$Ware"/>
              </do_if>
            </do_for_each>
          </do_if>
          <do_for_each name="$Ware" in="$R.$Wares.keys.list">
            <do_if value="not $R.$Wares.{$Ware}.$Active and $R.$Wares.{$Ware}.$Rate gt 0">
              <set_value name="$R.$Wares.{$Ware}.$Active" exact="true"/>
              <append_to_list name="$R.$DisplayOrder" exact="$Ware"/>
            </do_if>
          </do_for_each>
        </do_if>
      </actions>
    </library>
  </cues>
</mdscript>