<?xml version="1.0" encoding="utf-8"?>
<mdscript name="CE_Reserves" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <!-- All libraries execute synchronously in the caller's namespace. Requires R. -->
    <library name="SyncAll">
      <actions>
        <do_for_each name="$ReserveWare" in="$R.$Wares.keys.list">
          <set_value name="$ReserveState" exact="$R.$Wares.{$ReserveWare}"/>
          <do_if value="$ReserveState.$Reserve?">
            <include_actions ref="md.CE_Reserves.SyncWare"/>
          </do_if>
        </do_for_each>
      </actions>
    </library>
    <library name="SyncWare">
      <actions>
        <!-- ReserveState is explicit; never changes the caller's Ware/W bindings. -->
        <set_value name="$ReserveState.$Cap" exact="($ReserveState.$Rate * 2)i"/>
        <do_if value="$ReserveState.$Cap lt $ReserveState.$Rate * 2"><set_value name="$ReserveState.$Cap" operation="add"/></do_if>
        <set_value name="$ReserveState.$Demand" exact="[0.0f,$ReserveState.$Cap - $ReserveState.$Reserve].max"/>
      </actions>
    </library>
    <library name="Rebase">
      <actions>
        <include_actions ref="md.CE_Reserves.SyncAll"/>
        <set_value name="$R.$Last" exact="player.age / 1s"/>
        <set_value name="$R.$Qualified" exact="false"/>
      </actions>
    </library>
    <library name="Accrue">
      <actions>
        <include_actions ref="md.CE_Settings.RequiredGrowth"/>
        <include_actions ref="md.CE_Reserves.SyncAll"/>
        <set_value name="$ReserveNow" exact="player.age / 1s"/>
        <set_value name="$ReserveElapsed" exact="[0.0f,$ReserveNow - $R.$Last].max"/>
        <set_value name="$SuppliedSeconds" exact="$ReserveElapsed"/>
        <set_value name="$RequiredWares" exact="0"/>
        <do_if value="$R.$Operational">
          <do_for_each name="$ReserveWare" in="$R.$Wares.keys.list">
            <set_value name="$ReserveState" exact="$R.$Wares.{$ReserveWare}"/>
            <do_if value="@$ReserveState.$Active and $ReserveState.$Rate gt 0">
              <set_value name="$RequiredWares" operation="add"/>
              <set_value name="$SuppliedSeconds" exact="[$SuppliedSeconds,$ReserveState.$Reserve * 3600.0f / $ReserveState.$Rate].min"/>
              <set_value name="$ReserveState.$Reserve" exact="[0.0f,$ReserveState.$Reserve - $ReserveState.$Rate * $ReserveElapsed / 3600.0f].max"/>
              <include_actions ref="md.CE_Reserves.SyncWare"/>
            </do_if>
          </do_for_each>
          <do_if value="$RequiredWares gt 0 and $R.$Target == 0 and $R.$Level lt 10">
            <set_value name="$R.$GrowthSeconds" exact="[$R.$GrowthSeconds,[$RequiredGrowthSeconds,$R.$GrowthSeconds + $SuppliedSeconds].min].max"/>
          </do_if>
        </do_if>
        <set_value name="$R.$Last" exact="$ReserveNow"/>
      </actions>
    </library>
    <library name="Qualify">
      <actions>
        <include_actions ref="md.CE_Settings.RequiredGrowth"/>
        <set_value name="$RequiredWares" exact="0"/>
        <do_for_each name="$ReserveWare" in="$R.$Wares.keys.list">
          <do_if value="@$R.$Wares.{$ReserveWare}.$Active and $R.$Wares.{$ReserveWare}.$Rate gt 0"><set_value name="$RequiredWares" operation="add"/></do_if>
        </do_for_each>
        <set_value name="$R.$Qualified" exact="$R.$Operational and $RequiredWares gt 0 and $R.$Target == 0 and $R.$Level lt 10 and $R.$GrowthSeconds ge $RequiredGrowthSeconds"/>
      </actions>
    </library>
  </cues>
</mdscript>
